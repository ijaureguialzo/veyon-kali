# Veyon — ejemplo de configuración local.
#
# Copia este fichero a .env (que está en .gitignore) y ajústalo.  Todas
# las variables la leen scripts/veyon-source.sh, que es la única fuente de
# verdad del checkout del upstream (make download-src,
# scripts/build-veyon-macos.sh, ...).  Las variables ya presentes en el
# entorno tienen prioridad sobre las del .env.

# Versión del upstream a compilar: tag, rama o commit (p. ej. v4.11.4).
# Es la forma de cambiar de versión en un solo sitio.  Si se omite, se
# sigue la rama de VEYON_BRANCH (por defecto, main).
VEYON_VERSION=v4.11.4

# Repositorio del upstream (por defecto: https://github.com/veyon/veyon.git)
#VEYON_REPO_URL=

# Rama a mantener actualizada (solo si no hay VEYON_VERSION)
#VEYON_BRANCH=main

# Ruta del checkout único (por defecto: build/veyon en la raíz del proyecto)
#VEYON_SRC_DIR=build/veyon

# Descarta los cambios locales del checkout al actualizar
#VEYON_SOURCE_RESET=1

# No accede a la red; usa el checkout tal cual
#VEYON_SOURCE_OFFLINE=1
