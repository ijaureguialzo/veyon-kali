+
+struct ScreenCaptureKitVncScreen;
+
+/*!
+ * \brief A VNC server that captures the screen using ScreenCaptureKit
+ *
+ * This is the native screen capture backend of macOS.  The captured
+ * frames are copied into a software framebuffer that is served by the
+ * regular libVNC server infrastructure.
+ */
+class ScreenCaptureKitVncServer : public QObject, VncServerPluginInterface, PluginInterface
+{
+	Q_OBJECT
+	Q_PLUGIN_METADATA(IID "io.veyon.Veyon.Plugins.ScreenCaptureKitVncServer")
+	Q_INTERFACES(PluginInterface VncServerPluginInterface)
+public:
+	explicit ScreenCaptureKitVncServer( QObject* parent = nullptr );
+	~ScreenCaptureKitVncServer() override;
+
+	Plugin::Uid uid() const override
+	{
+		return Plugin::Uid{ QStringLiteral("8b5e0d4c-1a3f-4f27-9c58-2f6ad3e0b7c4") };
+	}
+
+	QVersionNumber version() const override
+	{
+		return QVersionNumber( 1, 0 );
+	}
+
+	QString name() const override
+	{
+		return QStringLiteral( "ScreenCaptureKitVncServer" );
+	}
+
+	QString description() const override
+	{
+		return tr( "ScreenCaptureKit VNC server" );
+	}
+
+	QString vendor() const override
+	{
+		return QStringLiteral( "Veyon Community" );
+	}
+
+	QString copyright() const override
+	{
+		return QStringLiteral( "Veyon Community" );
+	}
+
+	Plugin::Flags flags() const override
+	{
+		// The ScreenCaptureKit backend is the native screen capture
+		// implementation of macOS, so it is the default one there.
+		return Plugin::ProvidesDefaultImplementation;
+	}
+
+	QStringList supportedSessionTypes() const override
+	{
+		return {};
+	}
+
+	QWidget* configurationWidget() override;
+
+	void prepareServer() override;
+
+	bool runServer( int serverPort, const Password& password ) override;
+
+	int configuredServerPort() override
+	{
+		return -1;
+	}
+
+	Password configuredPassword() override
+	{
+		return {};
+	}
+
+private:
+	static constexpr auto DefaultFramebufferWidth = 640;
+	static constexpr auto DefaultFramebufferHeight = 480;
+	static constexpr auto DefaultSleepTime = 25;
+
+	ScreenCaptureKitConfiguration m_configuration;
+	ScreenCaptureKitCapturer* m_capturer{nullptr};
+
+	bool initScreen( ScreenCaptureKitVncScreen* screen );
+	bool initVncServer( int serverPort, const VncServerPluginInterface::Password& password,
+						ScreenCaptureKitVncScreen* screen );
+
+	/*!
+	 * \brief Copies the captured frame into the framebuffer of the server
+	 *
+	 * \return True if a new frame has been copied
+	 */
+	bool updateFramebuffer( ScreenCaptureKitVncScreen* screen );
+
+	static void rfbLogDebug( const char* format, ... );
+	static void rfbLogNone( const char* format, ... );
+};
