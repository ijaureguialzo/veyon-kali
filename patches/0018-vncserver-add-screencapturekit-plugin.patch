+
+#pragma once
+
+#include <QImage>
+#include <QObject>
+#include <QPoint>
+#include <QSize>
+#include <QString>
+#include <QVector>
+
+#include <mutex>
+
+// The capturer is used by another translation unit of the same plugin, so
+// its symbols have to be exported explicitly.  The plugin is built with
+// hidden visibility by default.
+#if defined(screencapturekit_vnc_server_EXPORTS)
+#  define VEYON_SCREENCAPTUREKIT_EXPORT Q_DECL_EXPORT
+#else
+#  define VEYON_SCREENCAPTUREKIT_EXPORT Q_DECL_IMPORT
+#endif
+
+// The Objective-C types are only known in the implementation file, so they
+// are stored as opaque pointers here.  They cannot be forward declared as
+// C++ classes, because the ScreenCaptureKit framework declares them as
+// Objective-C classes.
+
+/*!
+ * \brief Captures the screen contents using ScreenCaptureKit
+ *
+ * ScreenCaptureKit delivers the captured frames in a callback of its own
+ * thread.  The frames are stored in a framebuffer that is protected by a
+ * mutex, so that the VNC server thread can pick them up safely.
+ *
+ * The class requires the "Screen Recording" privacy permission.  Without
+ * it, ScreenCaptureKit refuses to provide any content and reports an
+ * error.
+ *
+ * ScreenCaptureKit captures one display per stream.  When several displays
+ * are combined, one stream is started for each of them and the individual
+ * frames are composed into a single virtual desktop, whose geometry matches
+ * the arrangement of the physical displays.
+ */
+class VEYON_SCREENCAPTUREKIT_EXPORT ScreenCaptureKitCapturer : public QObject
+{
+	Q_OBJECT
+public:
+	ScreenCaptureKitCapturer( QObject* parent = nullptr );
+	~ScreenCaptureKitCapturer() override;
+
+	/*!
+	 * \brief Starts the screen capture
+	 *
+	 * \param framesPerSecond The requested frame rate
+	 * \param captureAllDisplays Whether all displays are combined
+	 * \param displayIndex The index of the display to capture
+	 * \param maximumSize The maximum size of the captured frames
+	 * \return True if the capture was started
+	 */
+	bool start( int framesPerSecond, bool captureAllDisplays, int displayIndex, const QSize& maximumSize );
+
+	/*!
+	 * \brief Stops the screen capture
+	 */
+	void stop();
+
+	/*!
+	 * \brief Returns whether the capture is currently running
+	 */
+	bool isRunning() const;
+
+	/*!
+	 * \brief Composes the frames of the displays into the virtual desktop
+	 *
+	 * The frames of the individual displays are combined into a single
+	 * image, whose size is the size of the virtual desktop.  The call has
+	 * to be made after the new frame flag has been reset and before the
+	 * current frame is read.
+	 */
+	void composeFrame();
+
+	/*!
+	 * \brief Returns the last captured frame
+	 *
+	 * An invalid image is returned if no frame has been captured yet.
+	 */
+	QImage currentFrame() const;
+
+	/*!
+	 * \brief Returns whether a new frame is available since the last call
+	 */
+	bool hasNewFrame() const;
+
+	/*!
+	 * \brief Marks the current frame as processed
+	 */
+	void resetNewFrame();
+
+	/*!
+	 * \brief Returns the size of the captured frames
+	 */
+	QSize framebufferSize() const;
+
+	/*!
+	 * \brief Returns a human readable description of the last error
+	 */
+	QString lastError() const;
+
+	/*!
+	 * \brief Returns whether ScreenCaptureKit is available on this system
+	 *
+	 * ScreenCaptureKit requires macOS 13 or later.
+	 */
+	static bool isAvailable();
+
+	/*!
+	 * \brief Returns whether the screen recording permission has been granted
+	 */
+	static bool hasScreenRecordingPermission();
+
+	/*!
+	 * \brief Requests the screen recording permission
+	 *
+	 * On macOS the permission is granted by the user in the system
+	 * settings, so this only triggers the system prompt.
+	 */
+	static void requestScreenRecordingPermission();
+
+Q_SIGNALS:
+	/*!
+	 * \brief Emitted when a new frame has been captured
+	 */
+	void frameCaptured();
+
+	/*!
+	 * \brief Emitted when the capture failed
+	 */
+	void captureError( const QString& message );
+
+public Q_SLOTS:
+	/*!
+	 * \brief Emits the frameCaptured() signal
+	 *
+	 * The frames are delivered by ScreenCaptureKit in a queue of its own.
+	 * The notification of the receivers has to happen in the thread of the
+	 * capturer, so the callback of the queue only schedules this slot,
+	 * which then emits the signal.
+	 */
+	void notifyFrameCaptured();
+
+private:
+	/*!
+	 * \brief The state of a single captured display
+	 *
+	 * Every display is captured by its own stream, so that the frames of
+	 * several displays can be combined into one virtual desktop.
+	 */
+	struct DisplayState
+	{
+		void* stream{nullptr};
+		void* contentFilter{nullptr};
+		void* streamConfiguration{nullptr};
+		void* streamOutput{nullptr};
+
+		// The position of the display inside the virtual desktop.
+		QPoint position;
+		QSize size;
+	};
+
+	mutable std::mutex m_frameMutex;
+	QImage m_frame;
+	QSize m_framebufferSize;
+	bool m_newFrame{false};
+	QString m_errorMessage;
+
+	// The frame of every single display, before they are composed.
+	QVector<QImage> m_displayFrames;
+
+	QVector<DisplayState> m_displays;
+
+	void* m_callbackQueue{nullptr};
+};
