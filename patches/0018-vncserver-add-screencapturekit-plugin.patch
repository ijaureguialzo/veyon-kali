+	ui->setupUi( this );
+
+	FOREACH_SCREENCAPTUREKIT_VNC_CONFIG_PROPERTY( INIT_WIDGET_FROM_PROPERTY );
+	FOREACH_SCREENCAPTUREKIT_VNC_CONFIG_PROPERTY( CONNECT_WIDGET_TO_PROPERTY );
+
+	// The display index is only relevant when a single display is captured.
+	connect( ui->captureAllDisplays, &QCheckBox::toggled, this, [this]( bool checked ) {
+		ui->displayIndex->setEnabled( checked == false );
+	} );
+	ui->displayIndex->setEnabled( ui->captureAllDisplays->isChecked() == false );
+}
+
+
+
+ScreenCaptureKitVncServerConfigurationWidget::~ScreenCaptureKitVncServerConfigurationWidget()
+{
+	delete ui;
+}
