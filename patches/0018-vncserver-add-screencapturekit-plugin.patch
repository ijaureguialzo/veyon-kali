+#include "VeyonConfiguration.h"
+
+
+struct ScreenCaptureKitVncScreen
+{
+	~ScreenCaptureKitVncScreen()
+	{
+		delete[] passwords[0];
+	}
+
+	rfbScreenInfoPtr rfbScreen{nullptr};
+	std::array<char *, 2> passwords{};
+	QImage framebuffer;
+};
+
+
+ScreenCaptureKitVncServer::ScreenCaptureKitVncServer( QObject* parent ) :
+	QObject( parent ),
+	m_configuration( &VeyonCore::config() )
+{
+}
+
+
+
+ScreenCaptureKitVncServer::~ScreenCaptureKitVncServer()
+{
+	delete m_capturer;
+}
+
+
+
+QWidget* ScreenCaptureKitVncServer::configurationWidget()
+{
+	return new ScreenCaptureKitVncServerConfigurationWidget( m_configuration );
+}
+
+
+
+void ScreenCaptureKitVncServer::prepareServer()
+{
+}
+
+
+
+bool ScreenCaptureKitVncServer::runServer( int serverPort, const Password& password )
+{
+	if (VeyonCore::isDebugging())
+	{
+		rfbLog = rfbLogDebug;
+		rfbErr = rfbLogDebug;
+	}
+	else
+	{
+		rfbLog = rfbLogNone;
+		rfbErr = rfbLogNone;
+	}
+
+	ScreenCaptureKitVncScreen screen;
+
+	// The capture is started before the server is initialized, so that the
+	// size of the framebuffer is known before the first client connects.
+	m_capturer = new ScreenCaptureKitCapturer();
+
+	if( m_capturer->start( m_configuration.framesPerSecond(),
+						   m_configuration.captureAllDisplays(),
+						   m_configuration.displayIndex(),
+						   QSize( m_configuration.maxWidth(), m_configuration.maxHeight() ) ) == false )
+	{
+		vCritical() << "could not start the screen capture:" << m_capturer->lastError();
+		return false;
+	}
+
+	if( initScreen( &screen ) == false ||
+		initVncServer( serverPort, password, &screen ) == false )
+	{
+		m_capturer->stop();
+		return false;
+	}
+
+	while( true )
+	{
+		QThread::msleep( DefaultSleepTime );
+
+		updateFramebuffer( &screen );
+
+		rfbProcessEvents( screen.rfbScreen, 0 );
+	}
+
+	rfbShutdownServer( screen.rfbScreen, true );
+	rfbScreenCleanup( screen.rfbScreen );
+
+	return true;
+}
+
+
+
+bool ScreenCaptureKitVncServer::initScreen( ScreenCaptureKitVncScreen* screen )
+{
+	// The size of the framebuffer is taken from the capture, so that the
+	// framebuffer matches the resolution of the captured screen.
+	auto size = m_capturer != nullptr ? m_capturer->framebufferSize() : QSize();
+
+	if( size.isValid() && size.isEmpty() == false )
+	{
+		screen->framebuffer = QImage( size, QImage::Format_RGB32 );
+	}
+	else
+	{
+		// The capture has not delivered a frame yet, so a placeholder is
+		// used until the first frame arrives.
+		screen->framebuffer = QImage( DefaultFramebufferWidth, DefaultFramebufferHeight, QImage::Format_RGB32 );
+	}
+
+	screen->framebuffer.fill( Qt::black );
+
+	return true;
+}
+
+
+
+bool ScreenCaptureKitVncServer::initVncServer( int serverPort, const VncServerPluginInterface::Password& password,
+												ScreenCaptureKitVncScreen* screen )
+{
+	auto rfbScreen = rfbGetScreen( nullptr, nullptr,
+								   screen->framebuffer.width(), screen->framebuffer.height(),
+								   8, 3, 4 );
+
+	if( rfbScreen == nullptr )
+	{
+		return false;
+	}
+
+	screen->passwords[0] = qstrdup( password.toByteArray().constData() );
+
+	rfbScreen->desktopName = "VeyonVNC";
+	rfbScreen->frameBuffer = reinterpret_cast<char *>( screen->framebuffer.bits() );
+	rfbScreen->port = serverPort;
+	rfbScreen->ipv6port = serverPort;
+
+	rfbScreen->listenInterface = htonl(INADDR_LOOPBACK);
+	rfbScreen->listen6Interface = const_cast<char*>("::1");
+
+	rfbScreen->authPasswdData = screen->passwords.data();
+	rfbScreen->passwordCheck = rfbCheckPasswordByList;
+
+	rfbScreen->serverFormat.redShift = 16;
+	rfbScreen->serverFormat.greenShift = 8;
+	rfbScreen->serverFormat.blueShift = 0;
+
+	rfbScreen->serverFormat.redMax = 255;
+	rfbScreen->serverFormat.greenMax = 255;
+	rfbScreen->serverFormat.blueMax = 255;
+
+	rfbScreen->serverFormat.trueColour = true;
+	rfbScreen->serverFormat.bitsPerPixel = 32;
+
+	rfbScreen->alwaysShared = true;
+	rfbScreen->handleEventsEagerly = true;
+	rfbScreen->deferUpdateTime = 5;
+
+	rfbScreen->screenData = screen;
+
+	rfbScreen->cursor = nullptr;
+
+	rfbInitServer( rfbScreen );
+
+	rfbMarkRectAsModified( rfbScreen, 0, 0, rfbScreen->width, rfbScreen->height );
+
+	screen->rfbScreen = rfbScreen;
+
+	return true;
+}
+
+
+
+bool ScreenCaptureKitVncServer::updateFramebuffer( ScreenCaptureKitVncScreen* screen )
+{
+	if( m_capturer == nullptr || m_capturer->hasNewFrame() == false )
+	{
+		return false;
+	}
+
+	// The flag is reset, so that the same frame is not copied again.
+	m_capturer->resetNewFrame();
+
+	// The frames of the individual displays are combined into the virtual
+	// desktop before the frame is read.
+	m_capturer->composeFrame();
+
+	const auto frame = m_capturer->currentFrame();
+	if( frame.isNull() )
+	{
+		return false;
+	}
+
+	if( frame.size() != screen->framebuffer.size() )
+	{
+		// The resolution of the screen has changed, so the framebuffer and
+		// the libVNC screen have to be resized.
+		screen->framebuffer = QImage( frame.size(), QImage::Format_RGB32 );
+		screen->framebuffer.fill( Qt::black );
+
+		screen->rfbScreen->width = frame.width();
+		screen->rfbScreen->height = frame.height();
+		screen->rfbScreen->frameBuffer = reinterpret_cast<char *>( screen->framebuffer.bits() );
+
+		vInfo() << "framebuffer resized to" << frame.width() << "x" << frame.height();
+	}
+	else
+	{
+		// The frame is copied line by line, so that the address of the
+		// framebuffer stays the same.  libVNC keeps a pointer to it.
+		for( int line = 0; line < frame.height(); ++line )
+		{
+			std::memcpy( screen->framebuffer.scanLine( line ), frame.constScanLine( line ), frame.bytesPerLine() );
+		}
+	}
+
+	rfbMarkRectAsModified( screen->rfbScreen, 0, 0, screen->rfbScreen->width, screen->rfbScreen->height );
+
+	return true;
+}
+
+
+
+void ScreenCaptureKitVncServer::rfbLogDebug( const char* format, ... )
+{
+	va_list args;
+	va_start(args, format);
+
+	static constexpr int MaxMessageLength = 256;
+	std::array<char, MaxMessageLength> message;
+
+	std::vsnprintf(message.data(), message.size(), format, args); // Flawfinder: ignore
+
+	va_end(args);
+
+	vDebug() << message.data();
+}
+
+
+
+void ScreenCaptureKitVncServer::rfbLogNone( const char* format, ... )
+{
+	Q_UNUSED(format);
+}
+
+
+IMPLEMENT_CONFIG_PROXY(ScreenCaptureKitConfiguration)
