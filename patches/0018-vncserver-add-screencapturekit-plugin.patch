+ * modify it under the terms of the GNU General Public
+ * License as published by the Free Software Foundation; either
+ * version 2 of the License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public
+ * License along with this program (see COPYING); if not, write to the
+ * Free Software Foundation, Inc., 59 Temple Place - Suite 330,
+ * Boston, MA 02111-1307, USA.
+ *
+ */
+
+#include "ScreenCaptureKitCapturer.h"
+
+#include "Logger.h"
+
+// ScreenCaptureKit is only available on macOS 13 and later.  The whole
+// implementation is therefore guarded, so that the plugin can still be
+// compiled (and simply report an error at runtime) on older systems.
+//
+// The version macros of the SDK are only available after the headers of the
+// system frameworks have been included, so the frameworks are imported first
+// and the availability is checked afterwards.
+//
+// Clang does not define __MAC_OS_X_VERSION_MIN_REQUIRED.  The version of the
+// SDK that is used is available as __MAC_OS_X_VERSION_MAX_ALLOWED and the
+// version of the deployment target as
+// __ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__.
+#import <Availability.h>
+#import <ScreenCaptureKit/ScreenCaptureKit.h>
+#import <AVFoundation/AVFoundation.h>
+#import <CoreMedia/CoreMedia.h>
+#import <CoreVideo/CoreVideo.h>
+
+// ScreenCaptureKit was introduced with macOS 13 (13.00.00 == 130000).
+#if defined(__MAC_OS_X_VERSION_MAX_ALLOWED) && ( __MAC_OS_X_VERSION_MAX_ALLOWED >= 130000 ) && ( __ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__ >= 130000 )
+
+#define VEYON_SCREENCAPTUREKIT_AVAILABLE 1
+
+#include <mutex>
+
+#include <cstring>
+
+namespace vnc {
+
+/*!
+ * \brief Output handler of the screen capture stream
+ *
+ * ScreenCaptureKit delivers the frames through the output handler, which
+ * is called in the queue that was given to "addStreamOutput".  The frames
+ * are copied into a framebuffer that is protected by a mutex, so that the
+ * VNC server thread can pick them up safely.
+ */
+} // namespace vnc
+
+@interface ScreenCaptureKitStreamOutput : NSObject < SCStreamOutput >
+{
+	std::mutex* m_frameMutex;
+	QImage* m_displayFrames;
+	bool* m_newFrame;
+	int m_displayIndex;
+	ScreenCaptureKitCapturer* m_capturer;
+}
+
+- (instancetype)initWithFrameMutex: (std::mutex*) frameMutex
+					 displayFrames: (QImage*) displayFrames
+						 newFrameFlag: (bool*) newFrameFlag
+					  displayIndex: (int) displayIndex
+						   capturer: (ScreenCaptureKitCapturer*) capturer;
+
+@end
+
+@implementation ScreenCaptureKitStreamOutput
+
+- (instancetype)initWithFrameMutex: (std::mutex*) frameMutex
+					 displayFrames: (QImage*) displayFrames
+						 newFrameFlag: (bool*) newFrameFlag
+					  displayIndex: (int) displayIndex
+						   capturer: (ScreenCaptureKitCapturer*) capturer
+{
+	if( (self = [super init]) )
+	{
+		m_frameMutex = frameMutex;
+		m_displayFrames = displayFrames;
+		m_newFrame = newFrameFlag;
+		m_displayIndex = displayIndex;
+		m_capturer = capturer;
+	}
+	return self;
+}
+
+- (void)stream: (SCStream*) stream didOutputSampleBuffer: (CMSampleBufferRef) sampleBuffer ofType: (SCStreamOutputType) type
+{
+	Q_UNUSED( stream )
+	Q_UNUSED( type )
+
+	if( sampleBuffer == nullptr )
+	{
+		return;
+	}
+
+	CVImageBufferRef imageBuffer = CMSampleBufferGetImageBuffer( sampleBuffer );
+	if( imageBuffer == nullptr )
+	{
+		return;
+	}
+
+	const auto width = static_cast<int>( CVPixelBufferGetWidth( imageBuffer ) );
+	const auto height = static_cast<int>( CVPixelBufferGetHeight( imageBuffer ) );
+	if( width <= 0 || height <= 0 )
+	{
+		return;
+	}
+
+	// The base address has to stay valid while the frame is copied, so the
+	// buffer is only unlocked after the copy has been made.
+	CVPixelBufferLockBaseAddress( imageBuffer, kCVPixelBufferLock_ReadOnly );
+	const auto baseAddress = CVPixelBufferGetBaseAddress( imageBuffer );
+	const auto bytesPerRow = CVPixelBufferGetBytesPerRow( imageBuffer );
+
+	if( baseAddress == nullptr || bytesPerRow <= 0 )
+	{
+		CVPixelBufferUnlockBaseAddress( imageBuffer, kCVPixelBufferLock_ReadOnly );
+		return;
+	}
+
+	// The frames are delivered in the BGRA format, which has the same
+	// memory layout as QImage::Format_RGB32 on little endian machines.
+	const QImage source( static_cast<const uchar *>( baseAddress ),
+						 width, height, static_cast<int>( bytesPerRow ), QImage::Format_RGB32 );
+	const QImage copy = source.copy();
+
+	CVPixelBufferUnlockBaseAddress( imageBuffer, kCVPixelBufferLock_ReadOnly );
+
+	{
+		std::lock_guard<std::mutex> lock( *m_frameMutex );
+		m_displayFrames[ m_displayIndex ] = copy;
+
+		// The flag is raised right here, in the thread that delivers the
+		// frame.  The VNC server thread does not run an event loop, so a
+		// queued slot invocation would never be processed there.
+		if( m_newFrame != nullptr )
+		{
+			*m_newFrame = true;
+		}
+	}
+
+	if( m_capturer != nullptr )
+	{
+		// The signal is emitted from the capture queue, so the receivers
+		// are notified in their own thread.  The signal is invoked through
+		// the meta object system, because the "emit" macro of Qt is not
+		// available in Objective-C++ translation units.
+		//
+		// A slot is invoked and not the signal itself: the signals are not
+		// part of the table of the invokable methods of the meta object,
+		// so an invocation of the signal fails with "No such method".  The
+		// slot emits the signal in the thread of the capturer.
+		//
+		// The name is given without the parameter list, because Qt 6 only
+		// accepts the plain name of the method in this overload.
+		QMetaObject::invokeMethod( m_capturer, "notifyFrameCaptured", Qt::QueuedConnection );
+	}
+}
+
+@end
+
+
+
+ScreenCaptureKitCapturer::ScreenCaptureKitCapturer( QObject* parent ) :
+	QObject( parent )
+{
+}
+
+
+
+ScreenCaptureKitCapturer::~ScreenCaptureKitCapturer()
+{
+	stop();
+}
+
+
+
+bool ScreenCaptureKitCapturer::isAvailable()
+{
+	return true;
+}
+
+
+
+bool ScreenCaptureKitCapturer::hasScreenRecordingPermission()
+{
+	// CGPreflightScreenCaptureAccess() returns true when the process is
+	// allowed to capture the screen.  It does not trigger any prompt.
+	return CGPreflightScreenCaptureAccess() != false;
+}
+
+
+
+void ScreenCaptureKitCapturer::requestScreenRecordingPermission()
+{
+	// This triggers the system prompt, if the permission has not been
+	// requested yet.  The user has to grant it in the system settings.
+	CGRequestScreenCaptureAccess();
+}
+
+
+
+bool ScreenCaptureKitCapturer::start( int framesPerSecond, bool captureAllDisplays, int displayIndex, const QSize& maximumSize )
+{
+	if( isRunning() )
+	{
+		return true;
+	}
+
+	if( hasScreenRecordingPermission() == false )
+	{
+		m_errorMessage = tr( "The \"Screen Recording\" privacy permission has not been granted. "
+							  "Grant it in the system settings under Privacy & Security > Screen Recording." );
+		return false;
+	}
+
+	// The list of the capturable displays is needed to build the content
+	// filter.  The API is asynchronous, so a semaphore is used to wait for
+	// the result without blocking the Qt event loop for too long.
+	auto semaphore = dispatch_semaphore_create( 0 );
+	__block SCShareableContent* shareableContent = nil;
+	__block NSError* contentError = nil;
+
+	[ SCShareableContent getShareableContentWithCompletionHandler: ^( SCShareableContent* content, NSError* error ) {
+		shareableContent = [ content retain ];
+		contentError = [ error retain ];
+		dispatch_semaphore_signal( semaphore );
+	} ];
+
+	const auto waitResult = dispatch_semaphore_wait( semaphore,
+													dispatch_time( DISPATCH_TIME_NOW, 10 * NSEC_PER_SEC ) );
+	dispatch_release( semaphore );
+	if( waitResult != 0 || shareableContent == nil )
+	{
+		m_errorMessage = tr( "Could not access the screen content: %1" )
+				.arg( contentError != nil ? QString::fromNSString( contentError.localizedDescription ) :
+					   tr( "the screen recording permission was denied" ) );
+		vCritical() << m_errorMessage;
+		[ contentError release ];
+		[ shareableContent release ];
+		return false;
+	}
+
+	if( shareableContent.displays.count == 0 )
+	{
+		// ScreenCaptureKit only reports the displays that are currently
+		// active.  On a machine whose displays are asleep (for example a
+		// headless server or a remote session without a physical display)
+		// no display is available at all, so the capture cannot be set up.
+		m_errorMessage = tr( "No active display could be captured. The displays of this "
+							  "computer are most likely asleep or the computer is running "
+							  "headless. ScreenCaptureKit requires an active display." );
+		vCritical() << m_errorMessage;
+		[ contentError release ];
+		[ shareableContent release ];
+		return false;
+	}
+
+	// The displays that are going to be captured.  ScreenCaptureKit
+	// captures one display per stream, so every selected display needs its
+	// own stream.
+	QVector<SCDisplay*> targetDisplays;
+
+	if( captureAllDisplays == false )
+	{
+		if( displayIndex < 0 || displayIndex >= static_cast<int>( shareableContent.displays.count ) )
+		{
+			m_errorMessage = tr( "Display index %1 is out of range." ).arg( displayIndex );
+			vCritical() << m_errorMessage;
+			[ contentError release ];
+			[ shareableContent release ];
+			return false;
+		}
+		targetDisplays.append( shareableContent.displays[ displayIndex ] );
+	}
+	else
+	{
+		// All the active displays are captured and combined into a single
+		// virtual desktop.
+		for( SCDisplay* display in shareableContent.displays )
+		{
+			targetDisplays.append( display );
+		}
+	}
+
+	// The geometry of the virtual desktop is calculated from the frames of
+	// the physical displays, so that the arrangement of the monitors is
+	// preserved.  The origin of the coordinate system is the top left
+	// corner of the bounding box of all the displays.
+	CGFloat boundingLeft = 0;
+	CGFloat boundingTop = 0;
+	CGFloat boundingRight = 0;
+	CGFloat boundingBottom = 0;
+
+	for( int i = 0; i < targetDisplays.count(); ++i )
+	{
+		const auto frame = targetDisplays[ i ].frame;
+		if( i == 0 )
+		{
+			boundingLeft = frame.origin.x;
+			boundingTop = frame.origin.y;
+			boundingRight = frame.origin.x + frame.size.width;
+			boundingBottom = frame.origin.y + frame.size.height;
+			continue;
+		}
+
+		boundingLeft = MIN( boundingLeft, frame.origin.x );
+		boundingTop = MIN( boundingTop, frame.origin.y );
+		boundingRight = MAX( boundingRight, frame.origin.x + frame.size.width );
+		boundingBottom = MAX( boundingBottom, frame.origin.y + frame.size.height );
+	}
+
+	const auto virtualWidth = static_cast<int>( boundingRight - boundingLeft );
+	const auto virtualHeight = static_cast<int>( boundingBottom - boundingTop );
+
+	// Every display is scaled by the same factor, so that the relative
+	// arrangement of the monitors is kept.
+	double scale = 1.0;
+	if( maximumSize.isValid() && maximumSize.isEmpty() == false )
+	{
+		if( virtualWidth > maximumSize.width() || virtualHeight > maximumSize.height() )
+		{
+			scale = qMin( static_cast<double>( maximumSize.width() ) / virtualWidth,
+						  static_cast<double>( maximumSize.height() ) / virtualHeight );
+		}
+	}
+
+	const auto scaledWidth = qMax( 1, static_cast<int>( virtualWidth * scale ) );
+	const auto scaledHeight = qMax( 1, static_cast<int>( virtualHeight * scale ) );
+
+	dispatch_queue_t callbackQueue = dispatch_queue_create( "io.veyon.screencapturekit", DISPATCH_QUEUE_SERIAL );
+	m_callbackQueue = callbackQueue;
+
+	m_displays.clear();
+	m_displayFrames.clear();
+	m_displayFrames.resize( targetDisplays.count() );
+
+	for( int i = 0; i < targetDisplays.count(); ++i )
+	{
+		SCDisplay* targetDisplay = targetDisplays[ i ];
+
+		// The content filter covers the whole display, including the
+		// desktop background and the dock.
+		SCContentFilter* contentFilter = [[SCContentFilter alloc] initWithDisplay: targetDisplay
+																excludingWindows:@[]];
+
+		SCStreamConfiguration* streamConfiguration = [[SCStreamConfiguration alloc] init];
+		streamConfiguration.capturesAudio = NO;
+		streamConfiguration.showsCursor = YES;
+		streamConfiguration.queueDepth = 3;
+		streamConfiguration.minimumFrameInterval = CMTimeMake( 1, MAX( 1, framesPerSecond ) );
+
+		// The size of the captured display in the virtual desktop.
+		const auto displayWidth = qMax( 1, static_cast<int>( targetDisplay.width * scale ) );
+		const auto displayHeight = qMax( 1, static_cast<int>( targetDisplay.height * scale ) );
+
+		streamConfiguration.width = static_cast<size_t>( displayWidth );
+		streamConfiguration.height = static_cast<size_t>( displayHeight );
+
+		// BGRA is the format that matches QImage::Format_RGB32 (little endian
+		// with the shifts 16/8/0 that libVNC expects).
+		streamConfiguration.pixelFormat = kCVPixelFormatType_32BGRA;
+
+		SCStream* stream = [[SCStream alloc] initWithFilter: contentFilter
+											  configuration: streamConfiguration
+												  delegate: nil];
+
+		ScreenCaptureKitStreamOutput* output =
+				[[ScreenCaptureKitStreamOutput alloc] initWithFrameMutex: &m_frameMutex
+														 displayFrames: m_displayFrames.data()
+														 newFrameFlag: &m_newFrame
+													  displayIndex: i
+														   capturer: this];
+
+		NSError* addOutputError = nil;
+		[ stream addStreamOutput: output
+							type: SCStreamOutputTypeScreen
+			sampleHandlerQueue: callbackQueue
+						   error: &addOutputError ];
+
+		if( addOutputError != nil )
+		{
+			m_errorMessage = tr( "Could not add the screen capture output: %1" )
+					.arg( QString::fromNSString( addOutputError.localizedDescription ) );
+			vCritical() << m_errorMessage;
+			[ addOutputError release ];
+			[ output release ];
+			[ stream release ];
+			[ streamConfiguration release ];
+			[ contentFilter release ];
+			stop();
+			return false;
+		}
+
+		DisplayState displayState;
+		displayState.stream = stream;
+		displayState.contentFilter = contentFilter;
+		displayState.streamConfiguration = streamConfiguration;
+		displayState.streamOutput = output;
+		displayState.size = QSize( displayWidth, displayHeight );
+		displayState.position = QPoint(
+					qMax( 0, static_cast<int>( ( targetDisplay.frame.origin.x - boundingLeft ) * scale ) ),
+					qMax( 0, static_cast<int>( ( targetDisplay.frame.origin.y - boundingTop ) * scale ) ) );
+
+		m_displays.append( displayState );
+	}
+
+	// The size of the virtual desktop is the sum of the sizes of the
+	// displays, scaled down if they are bigger than the maximum size.
+	m_framebufferSize = QSize( scaledWidth, scaledHeight );
+
+	// The capture is started asynchronously, so the result is waited for
+	// with a semaphore.
+	for( auto& displayState : m_displays )
+	{
+		auto startSemaphore = dispatch_semaphore_create( 0 );
+		__block NSError* startError = nil;
+
+		SCStream* stream = static_cast<SCStream*>( displayState.stream );
+		[ stream startCaptureWithCompletionHandler: ^( NSError* error ) {
+			startError = [ error retain ];
+			dispatch_semaphore_signal( startSemaphore );
+		} ];
+
+		dispatch_semaphore_wait( startSemaphore, dispatch_time( DISPATCH_TIME_NOW, 10 * NSEC_PER_SEC ) );
+		dispatch_release( startSemaphore );
+
+		if( startError != nil )
+		{
+			m_errorMessage = tr( "Could not start the screen capture: %1" )
+					.arg( QString::fromNSString( startError.localizedDescription ) );
+			vCritical() << m_errorMessage;
+			[ startError release ];
+			stop();
+			return false;
+		}
+	}
+
+	vInfo() << "screen capture started at" << framesPerSecond << "fps,"
+			<< m_displays.count() << "display(s),"
+			<< scaledWidth << "x" << scaledHeight;
+
+	// The shareable content is not needed any more, the displays and the
+	// content filters keep the required information.
+	[ contentError release ];
+	[ shareableContent release ];
+
+	return true;
+}
+
+
+
+void ScreenCaptureKitCapturer::stop()
+{
+	for( auto& displayState : m_displays )
+	{
+		if( displayState.stream != nullptr )
+		{
+			SCStream* stream = static_cast<SCStream*>( displayState.stream );
+
+			auto semaphore = dispatch_semaphore_create( 0 );
+			[ stream stopCaptureWithCompletionHandler: ^( NSError* error ) {
+				Q_UNUSED( error )
+				dispatch_semaphore_signal( semaphore );
+			} ];
+			dispatch_semaphore_wait( semaphore, dispatch_time( DISPATCH_TIME_NOW, 5 * NSEC_PER_SEC ) );
+			dispatch_release( semaphore );
+
+			[ stream release ];
+			displayState.stream = nullptr;
+		}
+
+		// The output handler is retained by the stream, so it has to be
+		// released explicitly.
+		if( displayState.streamOutput != nullptr )
+		{
+			[ static_cast<id>( displayState.streamOutput ) release ];
+			displayState.streamOutput = nullptr;
+		}
+
+		if( displayState.contentFilter != nullptr )
+		{
+			[ static_cast<id>( displayState.contentFilter ) release ];
+			displayState.contentFilter = nullptr;
+		}
+
+		if( displayState.streamConfiguration != nullptr )
+		{
+			[ static_cast<id>( displayState.streamConfiguration ) release ];
+			displayState.streamConfiguration = nullptr;
+		}
+	}
+
+	m_displays.clear();
+	m_displayFrames.clear();
+
+	if( m_callbackQueue != nullptr )
+	{
+		dispatch_release( static_cast<dispatch_queue_t>( m_callbackQueue ) );
+		m_callbackQueue = nullptr;
+	}
+}
+
+
+
+bool ScreenCaptureKitCapturer::isRunning() const
+{
+	return m_displays.isEmpty() == false;
+}
+
+
+
+void ScreenCaptureKitCapturer::composeFrame()
+{
+	std::lock_guard<std::mutex> lock( m_frameMutex );
+
+	if( m_displays.count() <= 1 )
+	{
+		// A single display needs no composition.
+		return;
+	}
+
+	// The virtual desktop is filled with black, so that the areas that are
+	// not covered by a display stay empty.
+	if( m_frame.size() != m_framebufferSize || m_frame.isNull() )
+	{
+		m_frame = QImage( m_framebufferSize, QImage::Format_RGB32 );
+		m_frame.fill( Qt::black );
+	}
+
+	for( int i = 0; i < m_displays.count() && i < m_displayFrames.count(); ++i )
+	{
+		const auto& displayFrame = m_displayFrames[ i ];
+		if( displayFrame.isNull() )
+		{
+			// No frame has been received for this display yet.
+			continue;
+		}
+
+		const auto& displayState = m_displays[ i ];
+		const auto target = displayState.position;
+
+		// The frame of the display is scaled to the size it occupies in the
+		// virtual desktop and painted at its position.
+		const auto scaled = displayFrame.scaled( displayState.size, Qt::IgnoreAspectRatio, Qt::FastTransformation );
+
+		for( int line = 0; line < scaled.height(); ++line )
+		{
+			const auto targetLine = target.y() + line;
+			if( targetLine < 0 || targetLine >= m_frame.height() )
+			{
+				continue;
+			}
+
+			const auto sourceLine = scaled.constScanLine( line );
+			auto* targetData = m_frame.scanLine( targetLine ) + target.x() * 4;
+
+			const auto copyWidth = qMin( scaled.width(), m_frame.width() - target.x() );
+			if( copyWidth <= 0 )
+			{
+				continue;
+			}
+
+			std::memcpy( targetData, sourceLine, static_cast<size_t>( copyWidth ) * 4 );
+		}
+	}
+}
+
+
+
+QImage ScreenCaptureKitCapturer::currentFrame() const
+{
+	std::lock_guard<std::mutex> lock( m_frameMutex );
+
+	if( m_displays.count() == 1 )
+	{
+		// A single display is used as it is, without any composition.
+		const auto& displayFrames = m_displayFrames;
+		if( displayFrames.isEmpty() == false && displayFrames[ 0 ].isNull() == false )
+		{
+			return displayFrames[ 0 ];
+		}
+	}
+
+	if( m_frame.isNull() == false )
+	{
+		return m_frame;
+	}
+
+	return {};
+}
+
+
+
+bool ScreenCaptureKitCapturer::hasNewFrame() const
+{
+	std::lock_guard<std::mutex> lock( m_frameMutex );
+	return m_newFrame;
+}
+
+
+
+void ScreenCaptureKitCapturer::resetNewFrame()
+{
+	std::lock_guard<std::mutex> lock( m_frameMutex );
+	m_newFrame = false;
+}
+
+
+
+QSize ScreenCaptureKitCapturer::framebufferSize() const
+{
+	std::lock_guard<std::mutex> lock( m_frameMutex );
+	return m_framebufferSize;
+}
+
+
+
+QString ScreenCaptureKitCapturer::lastError() const
+{
+	return m_errorMessage;
+}
+
+
+
+void ScreenCaptureKitCapturer::notifyFrameCaptured()
+{
+	// The new frame flag is raised by the callback of the capture queue,
+	// because the VNC server thread does not run an event loop and would
+	// never process a queued invocation.
+	Q_EMIT frameCaptured();
+}
+
+#else // ! VEYON_SCREENCAPTUREKIT_AVAILABLE
