@@ -0,0 +1,41 @@
+include(BuildVeyonPlugin)
+
+build_veyon_plugin(screencapturekit-vnc-server
+	NAME ScreenCaptureKitVncServer
+	SOURCES
+	ScreenCaptureKitVncServer.cpp
+	ScreenCaptureKitVncServer.h
+	ScreenCaptureKitVncServerConfigurationWidget.cpp
+	ScreenCaptureKitVncServerConfigurationWidget.h
+	ScreenCaptureKitVncServerConfigurationWidget.ui
+	ScreenCaptureKitCapturer.h
+	ScreenCaptureKitCapturer.mm
+	ScreenCaptureKitConfiguration.h
+)
+
+# El capturador es Objective-C++, de modo que se compila de forma aislada
+# y sin los headers precompilados, que no son compatibles con el
+#Objective-C++.
+set_source_files_properties(
+	ScreenCaptureKitCapturer.mm
+	PROPERTIES
+		COMPILE_FLAGS "-x objective-c++"
+		SKIP_UNITY_BUILD_INCLUSION TRUE
+		SKIP_PRECOMPILE_HEADERS TRUE
+)
+
+target_link_libraries(screencapturekit-vnc-server PRIVATE
+	"-framework ScreenCaptureKit"
+	"-framework AVFoundation"
+	"-framework CoreMedia"
+	"-framework CoreVideo"
+	"-framework CoreGraphics"
+)
+
+if(WITH_BUNDLED_LIBVNC)
+	target_link_libraries(screencapturekit-vnc-server PRIVATE vncserver)
+else()
+	target_link_libraries(screencapturekit-vnc-server PRIVATE LibVNC::LibVNCServer)
+endif()
+
+target_compile_options(screencapturekit-vnc-server PRIVATE -Wno-parentheses)
