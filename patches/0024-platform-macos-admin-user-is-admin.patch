 bool MacOSCoreFunctions::isRunningAsAdmin() const
 {
-	return geteuid() == 0;
+	if ( geteuid() == 0 )
+	{
+		return true;
+	}
+
+	// An admin user (member of the "admin" group) can also store Veyon's
+	// system domain settings without root: on macOS the CFPreferences
+	// writes are performed by the system cfprefsd, which runs as root and
+	// checks the caller's group membership.  This matters because the
+	// configurator re-launches itself elevated when this returns false, and
+	// a process started through "do shell script ... with administrator
+	// privileges" is a root child of /bin/sh that macOS will not activate
+	// as a GUI application: its window is drawn inactive (greyed-out
+	// widgets) and never receives keyboard events or clipboard access.
+	// Root is only needed for users who are not in the admin group.
+	return isAdminUser();
+}
+
+
+
+bool MacOSCoreFunctions::isAdminUser() const
+{
+	// The gid of the "admin" group is 80 on macOS; resolve it by name as a
+	// fallback in case the value changes.
+	std::set<gid_t> adminGids{ 80 };
+	if ( struct group* entry = getgrnam( "admin" ) )
+	{
+		adminGids.insert( entry->gr_gid );
+	}
+
+	auto inGroup = [ &adminGids ]( gid_t gid ) { return adminGids.count( gid ) > 0; };
+
+	if ( inGroup( getegid() ) )
+	{
+		return true;
+	}
+
+	int count = getgroups( 0, nullptr );
+	if ( count > 0 && count <= 1024 )
+	{
+		std::vector<gid_t> groups( static_cast<size_t>( count ) );
+		if ( getgroups( count, groups.data() ) == count )
+		{
+			for ( auto gid : groups )
+			{
+				if ( inGroup( gid ) )
+				{
+					return true;
+				}
+			}
+		}
+	}
+
+	return false;
 }
 
 
