+#include <IOKit/pwr_mgt/IOPMLib.h>
+
+#import <AppKit/AppKit.h>
+#import <Foundation/Foundation.h>
+#import <os/log.h>
+
+namespace {
+
+// Query a string-typed sysctl, e.g. "kern.osproductversion".
+QString sysctlString( const char* name )
+{
+	size_t length = 0;
+	if ( sysctlbyname( name, nullptr, &length, nullptr, 0 ) != 0 || length == 0 )
+	{
+		return {};
+	}
+
+	QByteArray buffer( static_cast<int>( length ), '\0' );
+	if ( sysctlbyname( name, buffer.data(), &length, nullptr, 0 ) != 0 )
+	{
+		return {};
+	}
+
+	// sysctl returns the length including the terminating NUL byte.
+	if ( length > 0 && buffer.at( length - 1 ) == '\0' )
+	{
+		buffer.chop( 1 );
+	}
+
+	return QString::fromUtf8( buffer );
+}
+
+} // namespace
+
+
+
+MacOSCoreFunctions::~MacOSCoreFunctions()
+{
+	restoreScreenSaverSettings();
+}
+
+
+
+bool MacOSCoreFunctions::applyConfiguration()
+{
+	// macOS has no equivalent of the Linux "apply current configuration to
+	// running session" mechanism.  Most settings are read on demand, so there
+	// is nothing to do here.
+	return true;
+}
+
+
+
+bool MacOSCoreFunctions::prepareSessionBusAccess()
+{
+	// macOS does not use a session bus (D-Bus).  The equivalent concept is
+	// the per-user Mach bootstrap namespace, which is available by default.
+	return true;
+}
+
+
+
+void MacOSCoreFunctions::initNativeLoggingSystem( const QString& appName )
+{
+	// Native logging on macOS is provided by the unified logging system.
+	// Veyon's own logging is handled by the Logger class, so there is nothing
+	// to initialize here.
+}
+
+
+
+void MacOSCoreFunctions::writeToNativeLoggingSystem( const QString& message, Logger::LogLevel loglevel )
+{
+#ifdef Q_OS_MACOS
+	os_log_type_t type = OS_LOG_TYPE_DEFAULT;
+	switch ( loglevel )
+	{
+		case Logger::LogLevel::Debug:
+			type = OS_LOG_TYPE_DEBUG; break;
+		case Logger::LogLevel::Info:
+			type = OS_LOG_TYPE_INFO; break;
+		case Logger::LogLevel::Warning:
+			type = OS_LOG_TYPE_DEFAULT; break;
+		case Logger::LogLevel::Error:
+			type = OS_LOG_TYPE_ERROR; break;
+		case Logger::LogLevel::Critical:
+			type = OS_LOG_TYPE_FAULT; break;
+		case Logger::LogLevel::Nothing:
+		case Logger::LogLevel::NumLogLevels:
+			type = OS_LOG_TYPE_DEFAULT; break;
+	}
+
+	os_log_with_type( OS_LOG_DEFAULT, type, "%{public}s", message.toUtf8().constData() );
+#endif
+}
+
+
+
+StandardInputReader* MacOSCoreFunctions::createStandardInputReader(QObject* parent)
+{
+	auto reader = new StandardInputReader(parent);
+
+	auto notifier = new QSocketNotifier(STDIN_FILENO, QSocketNotifier::Read, reader);
+	QObject::connect(notifier, &QSocketNotifier::activated,
+					 reader, [reader]() {
+		reader->lineRead(QTextStream(stdin).readLine());
+	});
+
+	return reader;
+}
+
+
+
+void MacOSCoreFunctions::reboot()
+{
+	// Ask the system to restart.  Requires the "system.restart" authorisation
+	// right, which is normally granted to administrators only.
+	CFURLRef url = CFURLCreateWithFileSystemPath( nullptr, CFSTR("/System/Library/CoreServices/restart.plist" ), kCFURLPOSIXPathStyle, true );
+	if ( url )
+	{
+		NSURL* nsUrl = [NSURL URLWithString:[[(__bridge NSURL*)url absoluteString] stringByAddingPercentEncodingWithAllowedCharacters:[NSCharacterSet URLQueryAllowedCharacterSet]]];
+		[[NSWorkspace sharedWorkspace] openURL:nsUrl];
+		CFRelease( url );
+	}
+}
+
+
+
+void MacOSCoreFunctions::powerDown( bool installUpdates )
+{
+	Q_UNUSED( installUpdates )
+
+	CFURLRef url = CFURLCreateWithFileSystemPath( nullptr, CFSTR("/System/Library/CoreServices/restart.plist" ), kCFURLPOSIXPathStyle, true );
+	if ( url )
+	{
+		NSURL* nsUrl = [NSURL URLWithString:[[(__bridge NSURL*)url absoluteString] stringByAddingPercentEncodingWithAllowedCharacters:[NSCharacterSet URLQueryAllowedCharacterSet]]];
+		[[NSWorkspace sharedWorkspace] openURL:nsUrl];
+		CFRelease( url );
+	}
+}
+
+
+
+void MacOSCoreFunctions::raiseWindow( QWidget* widget, bool stayOnTop )
+{
+	if ( widget == nullptr )
+	{
+		return;
+	}
+
+	widget->raise();
+	widget->activateWindow();
+
+	if ( stayOnTop )
+	{
+		widget->setWindowFlag( Qt::WindowStaysOnTopHint, true );
+	}
+
+	widget->show();
+}
+
+
+
+void MacOSCoreFunctions::disableScreenSaver()
+{
+	// Prevent the display from going to sleep while a Veyon session is active.
+	IOPMAssertionCreateWithName( kIOPMAssertionTypeNoDisplaySleep,
+								 IOPMAssertionLevel(kIOPMAssertionLevelOn),
+								 CFSTR("Veyon" ),
+								 &m_noDisplaySleepAssertion );
+}
+
+
+
+void MacOSCoreFunctions::restoreScreenSaverSettings()
+{
+	if ( m_noDisplaySleepAssertion != 0 )
+	{
+		IOPMAssertionRelease( m_noDisplaySleepAssertion );
+		m_noDisplaySleepAssertion = 0;
+	}
+}
+
+
+
+void MacOSCoreFunctions::setSystemUiState( bool enabled )
+{
+	// There is no global "hide all desktop elements" facility on macOS.
+	// The menu bar and the Dock can be hidden programmatically, but this is
+	// an application-level setting rather than a system-wide one.
+	Q_UNUSED( enabled )
+}
+
+
+
+QString MacOSCoreFunctions::activeDesktopName()
+{
+	// macOS does not have the concept of virtual desktops in the X11 sense.
+	// Spaces are used instead; report a stable name for the current space.
+	return QStringLiteral( "default" );
+}
+
+
+
+bool MacOSCoreFunctions::isRunningAsAdmin() const
+{
+	return geteuid() == 0;
+}
+
+
+
+bool MacOSCoreFunctions::runProgramAsAdmin( const QString& program, const QStringList& parameters )
+{
+	// macOS has no sudo equivalent for GUI applications.  The usual way to
+	// run a program with elevated privileges is to use the "do shell script"
+	// Apple event with administrator privileges, which requires the user to
+	// authenticate in a native dialog.
+	NSString* programString = program.toNSString();
+	NSMutableString* command = [NSMutableString stringWithString:@"/bin/sh -c "];
+	[command appendString:[programString stringByAppendingString:@" "]];
+
+	for ( const auto& parameter : parameters )
+	{
+		NSString* escaped = [parameter.toNSString() stringByReplacingOccurrencesOfString:@"'" withString:@"'\\''"];
+		[command appendFormat:@"'%@' ", escaped];
+	}
+
+	[command appendString:@"> /dev/null 2>&1"];
+
+	NSAppleScript* script = [[NSAppleScript alloc] initWithSource:
+							  [NSString stringWithFormat:@"do shell script \"%@\" with administrator privileges", command]];
+	NSDictionary* errorDictionary = nil;
+	[script executeAndReturnError:&errorDictionary];
+
+	return errorDictionary == nil;
+}
+
+
+
+bool MacOSCoreFunctions::runProgramAsUser(const QString& program,
+										  const QStringList& parameters,
+										  const QString& username,
+										  const QString& desktop,
+										  const QByteArray& stdInData )
+{
+	// macOS does not provide a supported API to start a process in another
+	// user's session.  The supported mechanism is "launchctl asuser" combined
+	// with "sudo -u", which requires root privileges.
+	Q_UNUSED( username )
+	Q_UNUSED( desktop )
+	Q_UNUSED( stdInData )
+
+	if ( isRunningAsAdmin() == false )
+	{
+		return false;
+	}
+
+	QStringList commandArguments;
+	commandArguments << QStringLiteral( "-u" ) << username << program;
+	commandArguments += parameters;
+
+	return QProcess::startDetached( QStringLiteral( "sudo" ), commandArguments );
+}
+
+
+
+QString MacOSCoreFunctions::genericUrlHandler() const
+{
+	return QStringLiteral( "veyon://" );
+}
+
+
+
+QString MacOSCoreFunctions::macOSVersion() const
+{
+	return sysctlString( "kern.osproductversion" );
+}
+
+
+
+QString MacOSCoreFunctions::queryDisplayDeviceName(const QScreen& screen) const
+{
+	// QScreen::name() returns the display identifier used by the window
+	// server on macOS, e.g. "1" for the first display.
+	return screen.name();
+}
+
+
+
+QString MacOSCoreFunctions::getApplicationName(ProcessId processId) const
+{
+	if ( processId <= 0 )
+	{
+		return {};
+	}
+
+	NSRunningApplication* application =
+		[NSRunningApplication runningApplicationWithProcessIdentifier:static_cast<pid_t>( processId )];
+	if ( application == nil )
+	{
+		return {};
+	}
+
+	NSString* name = [application localizedName];
+	if ( name == nil )
+	{
+		return {};
+	}
+
+	return QString::fromNSString( name );
+}
