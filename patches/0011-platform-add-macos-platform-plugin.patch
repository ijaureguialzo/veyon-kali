+ * Free Software Foundation, Inc., 59 Temple Place - Suite 330,
+ * Boston, MA 02111-1307, USA.
+ *
+ */
+
+#include <unistd.h>
+
+#include <QDir>
+#include <QFileInfo>
+#include <QProcess>
+
+#include "MacOSServerProcess.h"
+#include "VeyonCore.h"
+
+
+
+MacOSServerProcess::MacOSServerProcess( const QString& userName,
+										const QString& userHomeDirectory,
+										int userId,
+										const QString& serverPath,
+										QObject* parent ) :
+	QObject( parent ),
+	m_userName( userName ),
+	m_userHomeDirectory( userHomeDirectory ),
+	m_userId( userId ),
+	m_serverPath( serverPath )
+{
+	// The environment of the server is not inherited from the service.
+	// launchd provides the environment of the session of the user and
+	// the token of the service data manager is written into the launch
+	// agent, so that the server can exchange data with the service.
+}
+
+
+
+MacOSServerProcess::~MacOSServerProcess()
+{
+	stop();
+}
+
+
+
+QString MacOSServerProcess::launchAgentLabel()
+{
+	return QStringLiteral( "io.veyon.veyon-server" );
+}
+
+
+
+QString MacOSServerProcess::launchAgentPath( const QString& userName,
+										   const QString& userHomeDirectory )
+{
+	Q_UNUSED( userName )
+
+	// The launch agent has to be placed in the LaunchAgents directory of
+	// the user, so that launchd loads it into the GUI domain of that user
+	// when the session starts.  The home directory is taken from the
+	// password database, because it is not required to be located in
+	// /Users.
+	if( userHomeDirectory.isEmpty() )
+	{
+		return {};
+	}
+
+	return userHomeDirectory + QStringLiteral( "/Library/LaunchAgents/%1.plist" )
+			.arg( launchAgentLabel() );
+}
+
+
+
+void MacOSServerProcess::start()
+{
+	if( m_userId <= 0 )
+	{
+		vCritical() << "cannot start server for user" << m_userName << "- invalid user id";
+		return;
+	}
+
+	if( QFileInfo::exists( m_serverPath ) == false )
+	{
+		vCritical() << "cannot start server - executable not found:" << m_serverPath;
+		return;
+	}
+
+	const auto agentPath = launchAgentPath( m_userName, m_userHomeDirectory );
+	if( agentPath.isEmpty() )
+	{
+		vCritical() << "cannot start server for user" << m_userName
+					<< "- no home directory known";
+		return;
+	}
+
+	// The launch agent has to exist before it can be bootstrapped.
+	if( QFileInfo::exists( agentPath ) == false )
+	{
+		vWarning() << "no launch agent for user" << m_userName
+				   << "- server cannot be started";
+		return;
+	}
+
+	// The server is started by launchd, not by the service: the agent is
+	// bootstrapped into the GUI session domain of the user, which is
+	// required to access the window server of that session.
+	//
+	// "launchctl asuser" switches to the bootstrap namespace of the given
+	// user, but it only works with root privileges.  Without them the
+	// bootstrap is attempted directly, which succeeds when the service
+	// already runs inside the GUI session of that user.
+	const auto domain = QStringLiteral( "gui/%1" ).arg( m_userId );
+
+	QStringList arguments;
+	if( geteuid() == 0 )
+	{
+		arguments << QStringLiteral( "asuser" ) << QString::number( m_userId )
+				  << QStringLiteral( "/bin/launchctl" );
+	}
+	arguments << QStringLiteral( "bootstrap" ) << domain << agentPath;
+
+	QProcess process;
+	process.start( QStringLiteral( "/bin/launchctl" ), arguments );
+	if( process.waitForStarted( LaunchctlTimeout ) == false )
+	{
+		vCritical() << "could not start launch agent for user" << m_userName
+					<< ":" << process.errorString();
+		return;
+	}
+	process.waitForFinished( LaunchctlTimeout );
+
+	if( process.exitCode() != 0 )
+	{
+		vWarning() << "could not bootstrap launch agent for user" << m_userName
+				   << ":" << QString::fromUtf8( process.readAllStandardError() ).trimmed();
+	}
+}
+
+
+
+void MacOSServerProcess::stop()
+{
+	const auto agentPath = launchAgentPath( m_userName, m_userHomeDirectory );
+	if( agentPath.isEmpty() )
+	{
+		return;
+	}
+
+	// Unloading the agent stops the server with a SIGTERM and prevents
+	// launchd from starting it again.
+	QProcess process;
+	process.start( QStringLiteral( "/bin/launchctl" ),
+				  { QStringLiteral( "bootout" ),
+					QStringLiteral( "gui/%1" ).arg( m_userId ),
+					agentPath } );
+	if( process.waitForStarted( LaunchctlTimeout ) == false )
+	{
+		return;
+	}
+	process.waitForFinished( LaunchctlTimeout );
+}
+
+
+
+bool MacOSServerProcess::isRunning() const
+{
+	QProcess process;
+	process.start( QStringLiteral( "/bin/launchctl" ),
+				  { QStringLiteral( "print" ),
+					QStringLiteral( "gui/%1/%2" ).arg( m_userId ).arg( launchAgentLabel() ) } );
+	if( process.waitForStarted( LaunchctlTimeout ) == false )
+	{
+		return false;
+	}
+	process.waitForFinished( LaunchctlTimeout );
+
+	if( process.exitCode() != 0 )
+	{
+		return false;
+	}
+
+	return QString::fromUtf8( process.readAllStandardOutput() )
+			.contains( QLatin1String( "state = running" ) );
+}
