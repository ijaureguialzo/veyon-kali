+ * Free Software Foundation, Inc., 59 Temple Place - Suite 330,
+ * Boston, MA 02111-1307, USA.
+ *
+ */
+
+#pragma once
+
+#include <QProcess>
+#include <QProcessEnvironment>
+#include <QString>
+
+// clazy:excludeall=copyable-polymorphic
+
+/*!
+ * \brief Supervises a Veyon server instance on macOS
+ *
+ * The server itself is not started as a child process of the service.
+ * Instead it is run by launchd as a LaunchAgent inside the GUI session of
+ * the user, which is required to access the window server of that
+ * session.  This class therefore only supervises the launchd job: it
+ * queries the state of the job and it stops it when the service is
+ * shut down.
+ */
+class MacOSServerProcess : public QObject
+{
+	Q_OBJECT
+public:
+	MacOSServerProcess( const QProcessEnvironment& processEnvironment,
+						const QString& userName,
+						const QString& userHomeDirectory,
+						int userId,
+						const QString& serverPath,
+						QObject* parent = nullptr );
+	~MacOSServerProcess() override;
+
+	/*!
+	 * \brief Starts the launch agent of the user
+	 *
+	 * The agent is bootstrapped into the GUI domain of the user, so that
+	 * the server runs inside the graphical session.
+	 */
+	void start();
+
+	/*!
+	 * \brief Stops the launch agent of the user
+	 */
+	void stop();
+
+	/*!
+	 * \brief Returns whether the launch agent of the user is running
+	 */
+	bool isRunning() const;
+
+	/*!
+	 * \brief Returns the path of the launch agent of the given user
+	 *
+	 * The home directory of the user is taken from the password database
+	 * and must not be derived from the user name, because the home
+	 * directory of an account is not required to be located in /Users.
+	 */
+	static QString launchAgentPath( const QString& userName,
+									const QString& userHomeDirectory );
+
+	/*!
+	 * \brief Returns the label of the launch agent of the user
+	 */
+	static QString launchAgentLabel();
+
+private:
+	static constexpr auto LaunchctlTimeout = 10000;
+	static constexpr auto ServerTerminateTimeout = 2000;
+
+	const QString m_userName;
+	const QString m_userHomeDirectory;
+	const int m_userId;
+	const QString m_serverPath;
+};
