+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <QDir>
+#include <QFileInfo>
+#include <QStandardPaths>
+
+#include <csignal>
+
+#include "MacOSFilesystemFunctions.h"
+
+extern "C" {
+#include <sys/proc_info.h>
+#include <libproc.h>
+#include <grp.h>
+}
+
+
+
+QString MacOSFilesystemFunctions::personalAppDataPath() const
+{
+	// The equivalent of %LOCALAPPDATA%/%APPDATA% on macOS is
+	// ~/Library/Application Support, which is also the fallback of
+	// QStandardPaths::AppDataLocation.
+	auto path = QStandardPaths::writableLocation( QStandardPaths::AppDataLocation );
+	if ( path.isEmpty() )
+	{
+		path = QDir::homePath() + QStringLiteral( "/Library/Application Support" );
+	}
+	return path;
+}
+
+
+
+QString MacOSFilesystemFunctions::globalAppDataPath() const
+{
+	// System-wide equivalent of ~/Library/Application Support.
+	return QStringLiteral( "/Library/Application Support" );
+}
+
+
+
+QString MacOSFilesystemFunctions::globalTempPath() const
+{
+	return QStringLiteral( "/tmp" );
+}
+
+
+
+QString MacOSFilesystemFunctions::fileOwnerGroup( const QString& filePath )
+{
+	struct stat fileStat {};
+	if ( lstat( filePath.toUtf8().constData(), &fileStat ) != 0 )
+	{
+		return {};
+	}
+
+	// macOS has no group ownership in the POSIX sense for most files; the
+	// group id is inherited from the parent directory.  Report the group name
+	// when it can be resolved.
+	const auto groupName = ::getgrgid( fileStat.st_gid );
+	if ( groupName != nullptr )
+	{
+		return QString::fromUtf8( groupName->gr_name );
+	}
+
+	return QString::number( static_cast<uint>( fileStat.st_gid ) );
+}
+
+
+
+bool MacOSFilesystemFunctions::setFileOwnerGroup( const QString& filePath, const QString& ownerGroup )
+{
+	// Resolve the group name to a gid.
+	const auto group = ::getgrnam( ownerGroup.toUtf8().constData() );
+	if ( group == nullptr )
+	{
+		return false;
+	}
+
+	return ::chown( filePath.toUtf8().constData(), -1, group->gr_gid ) == 0;
+}
+
+
+
+bool MacOSFilesystemFunctions::setFileOwnerGroupPermissions( const QString& filePath, QFile::Permissions permissions )
+{
+	mode_t mode = 0;
+
+	if ( permissions & QFile::ReadOwner ) mode |= S_IRUSR;
+	if ( permissions & QFile::WriteOwner ) mode |= S_IWUSR;
+	if ( permissions & QFile::ExeOwner ) mode |= S_IXUSR;
+	if ( permissions & QFile::ReadGroup ) mode |= S_IRGRP;
+	if ( permissions & QFile::WriteGroup ) mode |= S_IWGRP;
+	if ( permissions & QFile::ExeGroup ) mode |= S_IXGRP;
+	if ( permissions & QFile::ReadOther ) mode |= S_IROTH;
+	if ( permissions & QFile::WriteOther ) mode |= S_IWOTH;
+	if ( permissions & QFile::ExeOther ) mode |= S_IXOTH;
+
+	return ::chmod( filePath.toUtf8().constData(), mode ) == 0;
+}
+
+
+
+bool MacOSFilesystemFunctions::openFileSafely( QFile* file, QFile::OpenMode openMode, QFile::Permissions permissions )
+{
+	if ( file == nullptr )
+	{
+		return false;
+	}
+
+	// Set the requested permissions before opening the file so that the file
+	// is never briefly world-readable.
+	if ( permissions != QFile::Permissions() )
+	{
+		const auto filePath = file->fileName();
+		if ( filePath.isEmpty() == false && file->exists() == false )
+		{
+			// Pre-create the file with the requested permissions.
+			const int fd = ::open( filePath.toUtf8().constData(),
+								   O_CREAT | O_EXCL | O_RDWR,
+								   0600 );
+			if ( fd < 0 )
+			{
+				return false;
+			}
+			::close( fd );
+			setFileOwnerGroupPermissions( filePath, permissions );
+		}
+	}
+
+	if ( file->open( openMode ) == false )
+	{
+		return false;
+	}
+
+	if ( permissions != QFile::Permissions() && file->exists() )
+	{
+		setFileOwnerGroupPermissions( file->fileName(), permissions );
+	}
+
+	return true;
+}
+
+
+
+PlatformCoreFunctions::ProcessId MacOSFilesystemFunctions::findFileLockingProcess(const QString& filePath) const
+{
+	// Use the lsof-free approach based on proc_listpids() to find out which
+	// process holds the given file open.
+	const auto path = filePath.toUtf8();
+
+	const int bufferSize = proc_listpids( PROC_ALL_PIDS, 0, nullptr, 0 );
+	if ( bufferSize <= 0 )
+	{
+		return PlatformCoreFunctions::InvalidProcessId;
+	}
+
+	QVector<pid_t> pids( bufferSize / sizeof( pid_t ) );
+	const int bytesUsed = proc_listpids( PROC_ALL_PIDS, 0, pids.data(), bufferSize );
+	if ( bytesUsed <= 0 )
+	{
+		return PlatformCoreFunctions::InvalidProcessId;
+	}
+
+	const int pidCount = bytesUsed / sizeof( pid_t );
+
+	for ( int i = 0; i < pidCount; ++i )
+	{
+		const auto pid = pids.at( i );
+		if ( pid <= 0 )
+		{
+			continue;
+		}
+
+		int fdCount = proc_pidinfo( pid, PROC_PIDLISTFDS, 0, nullptr, 0 );
+		if ( fdCount <= 0 )
+		{
+			continue;
+		}
+
+		QVector<proc_fdinfo> fds( fdCount / sizeof( proc_fdinfo ) );
+		fdCount = proc_pidinfo( pid, PROC_PIDLISTFDS, 0, fds.data(), fdCount );
+		if ( fdCount <= 0 )
+		{
+			continue;
+		}
+
+		const int fdInfoCount = fdCount / sizeof( proc_fdinfo );
+		for ( int j = 0; j < fdInfoCount; ++j )
+		{
+			const auto& fdInfo = fds.at( j );
+			if ( fdInfo.proc_fdtype != PROX_FDTYPE_VNODE )
+			{
+				continue;
+			}
+
+			char vnodeInfo[MAXPATHLEN] = {};
+			if ( proc_pidfdinfo( pid, fdInfo.proc_fd, PROC_PIDVNODEPATHINFO, &vnodeInfo, sizeof( vnodeInfo ) ) <= 0 )
+			{
+				continue;
+			}
+
+			if ( path == QByteArray( vnodeInfo ) )
+			{
+				return pid;
+			}
+		}
+	}
+
+	return PlatformCoreFunctions::InvalidProcessId;
+}
