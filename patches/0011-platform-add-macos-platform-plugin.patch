+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public
+ * License along with this program (see COPYING); if not, write to the
+ * Free Software Foundation, Inc., 59 Temple Place - Suite 330,
+ * Boston, MA 02111-1307, USA.
+ *
+ */
+
+#include <pwd.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <QCoreApplication>
+#include <QDir>
+#include <QEventLoop>
+#include <QFile>
+#include <QFileInfo>
+#include <QProcess>
+#include <QTimer>
+
+#include "MacOSServerProcess.h"
+#include "MacOSServiceCore.h"
+#include "VeyonCore.h"
+
+namespace {
+
+// The label of the launch agent that runs the Veyon server inside the
+// session of a user.
+QString launchAgentLabel()
+{
+	return QStringLiteral( "io.veyon.veyon-server" );
+}
+
+// Returns the path of the Veyon server executable that is installed
+// alongside the running service.
+QString serverExecutablePath()
+{
+	return QCoreApplication::applicationDirPath() + QDir::separator() +
+		   QStringLiteral( "veyon-server" );
+}
+
+// Escapes the characters that are not allowed in an XML attribute or text
+// node, so that the generated property list is always valid.
+QString escapeXmlValue( const QString& value )
+{
+	QString escaped = value;
+	escaped.replace( QStringLiteral( "&" ), QStringLiteral( "&amp;" ) );
+	escaped.replace( QStringLiteral( "<" ), QStringLiteral( "&lt;" ) );
+	escaped.replace( QStringLiteral( ">" ), QStringLiteral( "&gt;" ) );
+	return escaped;
+}
+
+} // namespace
+
+
+
+MacOSServiceCore::MacOSServiceCore( QObject* parent ) :
+	QObject( parent )
+{
+}
+
+
+
+MacOSServiceCore::~MacOSServiceCore()
+{
+	stopAllServers();
+}
+
+
+
+void MacOSServiceCore::run()
+{
+	// The service runs until it is terminated by launchd.  In the meantime
+	// it watches the console session and keeps a Veyon server running for
+	// the user that is logged in at the console.
+	vInfo() << "starting service core";
+
+	QEventLoop loop;
+
+	auto timer = new QTimer( this );
+	timer->setInterval( SessionProbingInterval );
+	connect( timer, &QTimer::timeout, this, &MacOSServiceCore::checkConsoleSession );
+	timer->start();
+
+	checkConsoleSession();
+
+	loop.exec();
+}
+
+
+
+QString MacOSServiceCore::consoleUserName()
+{
+	// The owner of /dev/console is the user that is logged in at the
+	// graphical console.  This is the same mechanism that the loginwindow
+	// uses, and unlike the dynamic store it does not require any
+	// additional framework.
+	struct stat consoleStat {};
+	if( ::stat( "/dev/console", &consoleStat ) != 0 )
+	{
+		return {};
+	}
+
+	if( consoleStat.st_uid == 0 )
+	{
+		// No user is logged in at the console.
+		return {};
+	}
+
+	const auto* passwdEntry = ::getpwuid( consoleStat.st_uid );
+	if( passwdEntry == nullptr )
+	{
+		return {};
+	}
+
+	return QString::fromUtf8( passwdEntry->pw_name );
+}
+
+
+
+QString MacOSServiceCore::userHomeDirectory( const QString& userName )
+{
+	const auto* passwdEntry = ::getpwnam( userName.toUtf8().constData() );
+	if( passwdEntry == nullptr )
+	{
+		return {};
+	}
+
+	return QString::fromUtf8( passwdEntry->pw_dir );
+}
+
+
+
+int MacOSServiceCore::userId( const QString& userName )
+{
+	const auto* passwdEntry = ::getpwnam( userName.toUtf8().constData() );
+	if( passwdEntry == nullptr )
+	{
+		return -1;
+	}
+
+	return static_cast<int>( passwdEntry->pw_uid );
+}
+
+
+
+void MacOSServiceCore::checkConsoleSession()
+{
+	const auto userName = consoleUserName();
+
+	if( userName.isEmpty() )
+	{
+		// Nobody is logged in at the console, so the servers of the
+		// previous session have to be stopped.
+		if( m_serverProcesses.isEmpty() == false )
+		{
+			vInfo() << "no user logged in at the console - stopping all servers";
+			stopAllServers();
+		}
+		return;
+	}
+
+	if( m_serverProcesses.contains( userName ) )
+	{
+		// The server is already running for this user, but it may have
+		// died in the meantime.
+		const auto serverProcess = m_serverProcesses.value( userName );
+		if( serverProcess->isRunning() == false )
+		{
+			vWarning() << "server for user" << userName << "is not running - restarting it";
+			serverProcess->deleteLater();
+			m_serverProcesses.remove( userName );
+			startServer( userName );
+		}
+		return;
+	}
+
+	startServer( userName );
+}
+
+
+
+void MacOSServiceCore::startServer( const QString& userName )
+{
+	const auto uid = userId( userName );
+	if( uid <= 0 )
+	{
+		vCritical() << "cannot start server for user" << userName << "- user not found";
+		return;
+	}
+
+	if( writeLaunchAgent( userName ) == false )
+	{
+		vCritical() << "cannot write launch agent for user" << userName;
+		return;
+	}
+
+	const auto serverPath = serverExecutablePath();
+	if( QFileInfo::exists( serverPath ) == false )
+	{
+		vCritical() << "cannot start server - executable not found:" << serverPath;
+		return;
+	}
+
+	vInfo() << "starting server for user" << userName << "at seat" << uid;
+
+	// The token of the service data manager is passed to the server so
+	// that it can exchange data with the service.  It is written into the
+	// launch agent, because launchd does not inherit the environment of
+	// the service.
+	auto serverProcess = new MacOSServerProcess( userName,
+												  userHomeDirectory( userName ), uid, serverPath, this );
+	serverProcess->start();
+
+	m_serverProcesses[userName] = serverProcess;
+}
+
+
+
+void MacOSServiceCore::stopServer( const QString& userName )
+{
+	if( m_serverProcesses.contains( userName ) == false )
+	{
+		return;
+	}
+
+	vInfo() << "stopping server for user" << userName;
+
+	auto serverProcess = m_serverProcesses.value( userName );
+	serverProcess->stop();
+	serverProcess->deleteLater();
+
+	m_serverProcesses.remove( userName );
+
+	removeLaunchAgent( userName );
+}
+
+
+
+void MacOSServiceCore::stopAllServers()
+{
+	while( m_serverProcesses.isEmpty() == false )
+	{
+		stopServer( m_serverProcesses.firstKey() );
+	}
+}
+
+
+
+bool MacOSServiceCore::writeLaunchAgent( const QString& userName ) const
+{
+	const auto homeDirectory = userHomeDirectory( userName );
+	if( homeDirectory.isEmpty() )
+	{
+		return false;
+	}
+
+	const auto launchAgentsDirectory = homeDirectory + QStringLiteral( "/Library/LaunchAgents" );
+
+	// The directory may not exist yet on a freshly created account.
+	QDir().mkpath( launchAgentsDirectory );
+
+	const auto plistPath = launchAgentsDirectory + QStringLiteral( "/io.veyon.veyon-server.plist" );
+	const auto serverPath = serverExecutablePath();
+
+	QString plist;
+	plist += QStringLiteral( "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" );
+	plist += QStringLiteral( "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
+							 "\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n" );
+	plist += QStringLiteral( "<plist version=\"1.0\">\n<dict>\n" );
+	plist += QStringLiteral( "\t<key>Label</key>\n\t<string>%1</string>\n" ).arg( launchAgentLabel() );
+	plist += QStringLiteral( "\t<key>ProgramArguments</key>\n\t<array>\n\t\t<string>%1</string>\n\t</array>\n" ).arg( serverPath );
+	plist += QStringLiteral( "\t<key>RunAtLoad</key>\n\t<true/>\n" );
+	plist += QStringLiteral( "\t<key>KeepAlive</key>\n\t<true/>\n" );
+	plist += QStringLiteral( "\t<key>ProcessType</key>\n\t<string>Interactive</string>\n" );
+	plist += QStringLiteral( "\t<key>LimitLoadToSessionType</key>\n\t<string>Aqua</string>\n" );
+	plist += QStringLiteral( "\t<key>ServiceDescription</key>\n\t<string>Veyon Server</string>\n" );
+
+	// The server is started by launchd, which does not inherit the
+	// environment of the service.  The token of the service data manager
+	// has to be passed explicitly, otherwise the server is not able to
+	// exchange any data with the service.
+	const auto tokenVariable = QString::fromLatin1( ServiceDataManager::serviceDataTokenEnvironmentVariable() );
+	const auto token = QString::fromUtf8( m_dataManager.token().toByteArray() );
+	if( token.isEmpty() == false )
+	{
+		plist += QStringLiteral( "\t<key>EnvironmentVariables</key>\n\t<dict>\n" );
+		plist += QStringLiteral( "\t\t<key>%1</key>\n\t\t<string>%2</string>\n" )
+				.arg( tokenVariable, escapeXmlValue( token ) );
+		plist += QStringLiteral( "\t</dict>\n" );
+	}
+
+	plist += QStringLiteral( "</dict>\n</plist>\n" );
+
+	QFile plistFile( plistPath );
+	if( plistFile.open( QIODevice::WriteOnly | QIODevice::Truncate ) == false )
+	{
+		vCritical() << "could not write launch agent:" << plistPath;
+		return false;
+	}
+	plistFile.write( plist.toUtf8() );
+	plistFile.close();
+
+	// The launch agent has to be owned by the user it belongs to.
+	if( geteuid() == 0 )
+	{
+		const auto uid = userId( userName );
+		if( uid > 0 )
+		{
+			::chown( plistPath.toUtf8().constData(), uid, uid );
+		}
+	}
+
+	// Make sure that the property list is syntactically valid.
+	QProcess process;
+	process.start( QStringLiteral( "/usr/bin/plutil" ),
+				  { QStringLiteral( "-lint" ), plistPath } );
+	if( process.waitForStarted( 5000 ) == false )
+	{
+		return false;
+	}
+	process.waitForFinished( 5000 );
+	if( process.exitCode() != 0 )
+	{
+		vCritical() << "invalid launch agent for user" << userName;
+		return false;
+	}
+
+	return true;
+}
+
+
+
+void MacOSServiceCore::removeLaunchAgent( const QString& userName ) const
+{
+	const auto uid = userId( userName );
+	const auto plistPath = MacOSServerProcess::launchAgentPath( userName, userHomeDirectory( userName ) );
+
+	if( plistPath.isEmpty() )
+	{
+		return;
+	}
+
+	if( uid > 0 )
+	{
+		QProcess bootout;
+		bootout.start( QStringLiteral( "/bin/launchctl" ),
+					  { QStringLiteral( "bootout" ),
+						QStringLiteral( "gui/%1" ).arg( uid ),
+						plistPath } );
+		bootout.waitForStarted( 5000 );
+		bootout.waitForFinished( 5000 );
+	}
+
+	QFile::remove( plistPath );
+}
