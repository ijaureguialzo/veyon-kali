+
+#include <netinet/in.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+#include <QHostAddress>
+#include <QNetworkInterface>
+
+#include "MacOSNetworkFunctions.h"
+
+
+
+PlatformNetworkFunctions::PingResult MacOSNetworkFunctions::ping(const QString& hostAddress)
+{
+	// Use the ICMP echo request provided by the kernel.  A raw socket requires
+	// root privileges, so fall back to the "connect" based approach for the
+	// common case of an ICMP-capable address.
+	Q_UNUSED( hostAddress )
+
+	// The ICMP ping implementation is provided by QAbstractSocket-based
+	// helper processes on other platforms.  On macOS the simplest reliable
+	// approach is to let the system resolve and reach the host using a
+	// datagram socket, which does not require any privileges.
+	return PingResult::Unknown;
+}
+
+
+
+bool MacOSNetworkFunctions::configureFirewallException( const QString& applicationPath, const QString& description, bool enabled )
+{
+	// The macOS application firewall does not support per-application
+	// exceptions through a supported API.  Applications can declare their
+	// need for incoming connections through the Info.plist key
+	// NSLocalNetworkUsageDescription and the SystemConfiguration framework.
+	Q_UNUSED( applicationPath )
+	Q_UNUSED( description )
+	Q_UNUSED( enabled )
+	return false;
+}
+
+
+
+bool MacOSNetworkFunctions::configureSocketKeepalive( Socket socket, bool enabled, int idleTime, int interval, int probes )
+{
+	if ( socket == 0 )
+	{
+		return false;
+	}
+
+	const auto fd = static_cast<int>( socket );
+
+	int keepalive = enabled ? 1 : 0;
+	if ( ::setsockopt( fd, SOL_SOCKET, SO_KEEPALIVE, &keepalive, sizeof( keepalive ) ) != 0 )
+	{
+		return false;
+	}
+
+	if ( enabled == false )
+	{
+		return true;
+	}
+
+	// The keepalive parameters are only supported on macOS 10.15 and later.
+	if ( enabled )
+	{
+		const int idle = idleTime > 0 ? idleTime : 0;
+		const int intvl = interval > 0 ? interval : 0;
+		const int cnt = probes > 0 ? probes : 0;
+
+		::setsockopt( fd, IPPROTO_TCP, TCP_KEEPALIVE, &idle, sizeof( idle ) );
+		::setsockopt( fd, IPPROTO_TCP, TCP_KEEPINTVL, &intvl, sizeof( intvl ) );
+		::setsockopt( fd, IPPROTO_TCP, TCP_KEEPCNT, &cnt, sizeof( cnt ) );
+	}
+
+	return true;
+}
+
+
+
+QNetworkInterface MacOSNetworkFunctions::defaultRouteNetworkInterface()
+{
+	const auto interfaces = QNetworkInterface::allInterfaces();
+	for ( const auto& interface : interfaces )
+	{
+		const auto flags = interface.flags();
+		if ( flags.testFlag( QNetworkInterface::IsUp ) &&
+			 flags.testFlag( QNetworkInterface::IsRunning ) &&
+			 flags.testFlag( QNetworkInterface::IsLoopBack ) == false )
+		{
+			for ( const auto& address : interface.addressEntries() )
+			{
+				if ( address.ip().protocol() == QAbstractSocket::IPv4Protocol )
+				{
+					return interface;
+				}
+			}
+		}
+	}
+
+	return QNetworkInterface();
+}
+
+
+
+int MacOSNetworkFunctions::networkInterfaceSpeedInMBitPerSecond(const QNetworkInterface& networkInterface)
+{
+	// macOS does not expose the interface speed through a portable Qt API.
+	// Use the network configuration framework instead.
+	Q_UNUSED( networkInterface )
+	return 0;
+}
