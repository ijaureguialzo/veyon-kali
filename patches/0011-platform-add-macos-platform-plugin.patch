+#include <grp.h>
+}
+
+namespace {
+
+// Run a command and return its trimmed standard output.
+QString runCommand( const QString& program, const QStringList& arguments )
+{
+	QProcess process;
+	process.start( program, arguments );
+	if ( process.waitForStarted( 5000 ) == false )
+	{
+		return {};
+	}
+	process.waitForFinished( 5000 );
+
+	if ( process.exitCode() != 0 )
+	{
+		return {};
+	}
+
+	return QString::fromUtf8( process.readAllStandardOutput() ).trimmed();
+}
+
+} // namespace
+
+
+
+QString MacOSUserFunctions::queryCurrentUserProperty(UserProperty property)
+{
+	const auto* user = ::getpwuid( ::getuid() );
+	if ( user == nullptr )
+	{
+		return {};
+	}
+
+	switch ( property )
+	{
+		case UserProperty::LoginName:
+			return QString::fromUtf8( user->pw_name );
+
+		case UserProperty::FullName:
+		{
+			// The full name is stored in the GECOS field of the password
+			// database.  Use "dscl" to read the real-name attribute, which
+			// also works for accounts from a directory service.
+			const auto fullName = runCommand( QStringLiteral( "/usr/bin/dscl" ),
+											 { QStringLiteral( "." ), QStringLiteral( "read" ),
+											   QStringLiteral( "/Users/%1" ).arg( QString::fromUtf8( user->pw_name ) ),
+											   QStringLiteral( "RealName" ) } );
+			if ( fullName.isEmpty() == false )
+			{
+				return fullName;
+			}
+
+			return QString::fromUtf8( user->pw_gecos );
+		}
+
+		case UserProperty::None:
+			break;
+	}
+
+	return {};
+}
+
+
+
+QStringList MacOSUserFunctions::userGroups( bool queryDomainGroups )
+{
+	// The "staff" group contains all users of the machine.
+	if ( queryDomainGroups )
+	{
+		const auto domainGroups = runCommand( QStringLiteral( "/usr/bin/dscl" ),
+											  { QStringLiteral( "." ), QStringLiteral( "read" ),
+												QStringLiteral( "/Users/%1" ).arg( QDir::home().dirName() ),
+												QStringLiteral( "MemberOf" ) } );
+		if ( domainGroups.isEmpty() == false )
+		{
+			QStringList groups;
+			const auto lines = domainGroups.split( QLatin1Char( '\n' ), Qt::SkipEmptyParts );
+			for ( const auto& line : lines )
+			{
+				auto group = line.trimmed();
+				if ( group.startsWith( QLatin1String( "MemberOf: " ) ) )
+				{
+					group = group.mid( 10 ).trimmed();
+				}
+				if ( group.isEmpty() == false )
+				{
+					groups += group;
+				}
+			}
+			return groups;
+		}
+	}
+
+	return { QStringLiteral( "staff" ) };
+}
+
+
+
+QStringList MacOSUserFunctions::groupsOfUser( const QString& username, bool queryDomainGroups )
+{
+	Q_UNUSED( queryDomainGroups )
+
+	QStringList groups;
+
+	const auto* user = ::getpwnam( username.toUtf8().constData() );
+	if ( user != nullptr )
+	{
+		int groupCount = 0;
+		::getgrouplist( user->pw_name, user->pw_gid, nullptr, &groupCount );
+		if ( groupCount > 0 )
+		{
+			QVector<int> groupIds( groupCount );
+			if ( ::getgrouplist( user->pw_name, user->pw_gid, groupIds.data(), &groupCount ) >= 0 )
+			{
+				for ( const auto groupId : groupIds )
+				{
+					const auto* group = ::getgrgid( static_cast<gid_t>( groupId ) );
+					if ( group != nullptr )
+					{
+						groups += QString::fromUtf8( group->gr_name );
+					}
+				}
+			}
+		}
+	}
+
+	return groups;
+}
+
+
+
+QString MacOSUserFunctions::userGroupSecurityIdentifier(const QString& groupName)
+{
+	// macOS groups are identified by their POSIX group id.
+	const auto* group = ::getgrnam( groupName.toUtf8().constData() );
+	if ( group == nullptr )
+	{
+		return {};
+	}
+
+	return QString::number( static_cast<uint>( group->gr_gid ) );
+}
+
+
+
+bool MacOSUserFunctions::isAnyUserLoggedOn()
+{
+	// The console user is reported by the WindowServer.  A non-empty
+	// "SConsoleUser" key means that a user is logged in graphically.
+	QProcess process;
+	process.start( QStringLiteral( "/usr/bin/stat" ),
+				  { QStringLiteral( "-f" ), QStringLiteral( "%Su" ), QStringLiteral( "/dev/console" ) } );
+	if ( process.waitForStarted( 3000 ) == false )
+	{
+		return false;
+	}
+	process.waitForFinished( 3000 );
+
+	const auto user = QString::fromUtf8( process.readAllStandardOutput() ).trimmed();
+	return user.isEmpty() == false && user != QLatin1String( "root" );
+}
+
+
+
+bool MacOSUserFunctions::prepareLogon( const QString& username, const Password& password )
+{
+	// macOS does not support a separate preparation phase for logons.
+	Q_UNUSED( username )
+	Q_UNUSED( password )
+	return true;
+}
+
+
+
+bool MacOSUserFunctions::performLogon( const QString& username, const Password& password )
+{
+	// Logging a user into a graphical session on macOS requires either
+	// Fast User Switching or a privileged helper.  Neither is available to a
+	// regular Veyon installation, so this is not supported.
+	Q_UNUSED( username )
+	Q_UNUSED( password )
+	return false;
+}
+
+
+
+void MacOSUserFunctions::logoff()
+{
+	// Logging off the current user is not supported.
+}
+
+
+
+bool MacOSUserFunctions::authenticate( const QString& username, const Password& password )
+{
+	// Authentication is delegated to the Open Directory via the
+	// "/usr/bin/dscl" "-authonly" command, which verifies a password
+	// without changing the session state.
+	const auto passwordString = QString::fromUtf8( password.constData() );
+
+	QProcess process;
+	process.start( QStringLiteral( "/usr/bin/dscl" ),
+				  { QStringLiteral( "." ), QStringLiteral( "-authonly" ),
+					username, passwordString } );
+	if ( process.waitForStarted( 5000 ) == false )
+	{
+		return false;
+	}
+	process.waitForFinished( 15000 );
+
+	return process.exitCode() == 0;
+}
