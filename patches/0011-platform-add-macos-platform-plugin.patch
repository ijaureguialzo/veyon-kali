index 000000000..e9a00d871
--- /dev/null
+++ b/plugins/platform/macos/MacOSServiceFunctions.cpp
@@ -0,0 +1,317 @@
+/*
+ * MacOSServiceFunctions.cpp - implementation of MacOSServiceFunctions class
+ *
+ * Copyright (c) 2026 Veyon Community
+ *
+ * This file is part of Veyon - https://veyon.io
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public
+ * License as published by the Free Software Foundation; either
+ * version 2 of the License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public
+ * License along with this program (see COPYING); if not, write to the
+ * Free Software Foundation, Inc., 59 Temple Place - Suite 330,
+ * Boston, MA 02111-1307, USA.
+ *
+ */
+
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QProcess>
+#include <QStandardPaths>
+
+#include "MacOSServiceCore.h"
+#include "MacOSServiceFunctions.h"
+
+namespace {
+
+// launchd services are identified by a reverse-DNS label, e.g.
+// "io.veyon.veyon-service".  The user agent domain is used for services
+// that run in the user's session, the system domain for root owned services.
+QString serviceLabel( const QString& name )
+{
+	if ( name.contains( QLatin1Char( '.' ) ) )
+	{
+		return name;
+	}
+	return QStringLiteral( "io.veyon." ) + name;
+}
+
+// Returns the domain the given service lives in.  Root owned services are
+// installed in the system domain, per user services in the GUI domain of
+// the current user.
+QString serviceDomain()
+{
+	if ( geteuid() == 0 )
+	{
+		return QStringLiteral( "system/" );
+	}
+
+	return QStringLiteral( "gui/" ) + QString::number( getuid() ) + QStringLiteral( "/" );
+}
+
+// Returns the path of the property list of the given service.
+QString servicePlistPath( const QString& name )
+{
+	const auto label = serviceLabel( name );
+
+	if ( geteuid() == 0 )
+	{
+		return QStringLiteral( "/Library/LaunchDaemons/%1.plist" ).arg( label );
+	}
+
+	return QDir::homePath() + QStringLiteral( "/Library/LaunchAgents/%1.plist" ).arg( label );
+}
+
+// Runs a launchctl command and returns whether it succeeded.
+bool runLaunchctl( const QStringList& arguments )
+{
+	QProcess process;
+	process.start( QStringLiteral( "/bin/launchctl" ), arguments );
+	if ( process.waitForStarted( 5000 ) == false )
+	{
+		return false;
+	}
+	process.waitForFinished( 5000 );
+
+	return process.exitCode() == 0;
+}
+
+} // namespace
+
+
+
+QString MacOSServiceFunctions::veyonServiceName() const
+{
+	return QStringLiteral( "veyon-service" );
+}
+
+
+
+QString MacOSServiceFunctions::launchctlPrint( const QString& name )
+{
+	const auto label = serviceLabel( name );
+
+	// The service is looked up in the system domain first and in the GUI
+	// domain of the current user afterwards, so that both root owned and
+	// per user services are found.
+	for( const auto& domain : { QStringLiteral( "system/" ), serviceDomain() } )
+	{
+		QProcess process;
+		process.start( QStringLiteral( "/bin/launchctl" ),
+					  { QStringLiteral( "print" ), domain + label } );
+		if ( process.waitForStarted( 5000 ) == false )
+		{
+			continue;
+		}
+		process.waitForFinished( 5000 );
+
+		if ( process.exitCode() == 0 )
+		{
+			return QString::fromUtf8( process.readAllStandardOutput() );
+		}
+	}
+
+	return {};
+}
+
+
+
+bool MacOSServiceFunctions::isRegistered( const QString& name )
+{
+	return launchctlPrint( name ).isEmpty() == false;
+}
+
+
+
+bool MacOSServiceFunctions::isRunning( const QString& name )
+{
+	const auto output = launchctlPrint( name );
+	if ( output.isEmpty() )
+	{
+		return false;
+	}
+
+	return output.contains( QLatin1String( "state = running" ) );
+}
+
+
+
+bool MacOSServiceFunctions::start( const QString& name )
+{
+	const auto label = serviceLabel( name );
+
+	if ( runLaunchctl( { QStringLiteral( "start" ), QStringLiteral( "system/" ) + label } ) )
+	{
+		return true;
+	}
+
+	return runLaunchctl( { QStringLiteral( "start" ), serviceDomain() + label } );
+}
+
+
+
+bool MacOSServiceFunctions::stop( const QString& name )
+{
+	const auto label = serviceLabel( name );
+
+	if ( runLaunchctl( { QStringLiteral( "stop" ), QStringLiteral( "system/" ) + label } ) )
+	{
+		return true;
+	}
+
+	return runLaunchctl( { QStringLiteral( "stop" ), serviceDomain() + label } );
+}
+
+
+
+bool MacOSServiceFunctions::install( const QString& name, const QString& filePath,
+									 StartMode startMode, const QString& displayName )
+{
+	// A launchd service is described by a property list that is installed in
+	// /Library/LaunchDaemons (system wide) or ~/Library/LaunchAgents (per user).
+	const auto label = serviceLabel( name );
+
+	QProcess process;
+
+	// Build the plist content.
+	QString plist;
+	plist += QStringLiteral( "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" );
+	plist += QStringLiteral( "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
+							 "\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n" );
+	plist += QStringLiteral( "<plist version=\"1.0\">\n<dict>\n" );
+	plist += QStringLiteral( "\t<key>Label</key>\n\t<string>%1</string>\n" ).arg( label );
+	plist += QStringLiteral( "\t<key>ProgramArguments</key>\n\t<array>\n\t\t<string>%1</string>\n\t</array>\n" ).arg( filePath );
+	plist += QStringLiteral( "\t<key>RunAtLoad</key>\n\t<%1/>\n" ).arg( startMode == StartMode::Auto ? "true" : "false" );
+	plist += QStringLiteral( "\t<key>KeepAlive</key>\n\t<%1/>\n" ).arg( startMode == StartMode::Auto ? "true" : "false" );
+	if ( displayName.isEmpty() == false )
+	{
+		plist += QStringLiteral( "\t<key>ServiceDescription</key>\n\t<string>%1</string>\n" ).arg( displayName );
+	}
+	plist += QStringLiteral( "\t<key>ProcessType</key>\n\t<string>Interactive</string>\n" );
+	plist += QStringLiteral( "</dict>\n</plist>\n" );
+
+	QString plistPath = servicePlistPath( name );
+
+	// The directory of per user agents may not exist yet.
+	if ( geteuid() != 0 )
+	{
+		QDir().mkpath( QFileInfo( plistPath ).absolutePath() );
+	}
+
+	QFile plistFile( plistPath );
+	if ( plistFile.open( QIODevice::WriteOnly | QIODevice::Truncate ) == false )
+	{
+		return false;
+	}
+	plistFile.write( plist.toUtf8() );
+	plistFile.close();
+
+	// Make sure that the plist is syntactically valid.
+	process.start( QStringLiteral( "/usr/bin/plutil" ),
+				  { QStringLiteral( "-lint" ), plistPath } );
+	if ( process.waitForStarted( 5000 ) == false )
+	{
+		return false;
+	}
+	process.waitForFinished( 5000 );
+	if ( process.exitCode() != 0 )
+	{
+		QFile::remove( plistPath );
+		return false;
+	}
+
+	// Unload a previously installed service, so that the new property list
+	// is the one that is actually used.
+	runLaunchctl( { QStringLiteral( "bootout" ), serviceDomain() + label } );
+
+	// Load the service so that it takes effect immediately.
+	return runLaunchctl( { QStringLiteral( "bootstrap" ), serviceDomain(), plistPath } );
+}
+
+
+
+bool MacOSServiceFunctions::uninstall( const QString& name )
+{
+	const auto label = serviceLabel( name );
+	const auto plistPath = servicePlistPath( name );
+
+	// Unload the service before removing its property list.
+	const auto unloaded = runLaunchctl( { QStringLiteral( "bootout" ), serviceDomain() + label } );
+
+	const bool removed = QFile::remove( plistPath );
+
+	// The service is considered uninstalled when its property list is gone
+	// or when it was not loaded in the first place.
+	return removed || unloaded;
+}
+
+
+
+bool MacOSServiceFunctions::setStartMode( const QString& name, StartMode startMode )
+{
+	// The start mode of a launchd service is controlled by the RunAtLoad and
+	// KeepAlive keys of its property list.
+	const auto label = serviceLabel( name );
+	const auto plistPath = servicePlistPath( name );
+
+	if ( QFile::exists( plistPath ) == false )
+	{
+		return false;
+	}
+
+	const auto value = startMode == StartMode::Auto ? QStringLiteral( "true" ) : QStringLiteral( "false" );
+
+	QProcess process;
+	process.start( QStringLiteral( "/usr/libexec/PlistBuddy" ),
+				  { QStringLiteral( "-c" ), QStringLiteral( "Set :RunAtLoad %1" ).arg( value ), plistPath } );
+	if ( process.waitForStarted( 5000 ) == false )
+	{
+		return false;
+	}
+	process.waitForFinished( 5000 );
+	if ( process.exitCode() != 0 )
+	{
+		return false;
+	}
+
+	process.start( QStringLiteral( "/usr/libexec/PlistBuddy" ),
+				  { QStringLiteral( "-c" ), QStringLiteral( "Set :KeepAlive %1" ).arg( value ), plistPath } );
+	if ( process.waitForStarted( 5000 ) == false )
+	{
+		return false;
+	}
+	process.waitForFinished( 5000 );
+
+	return process.exitCode() == 0;
+}
+
+
+
+bool MacOSServiceFunctions::runAsService( const QString& name, const ServiceEntryPoint& serviceEntryPoint )
+{
+	// When running as a launchd service the entry point is invoked directly,
+	// as the service process is the launchd job itself.
+	vInfo() << "running as service:" << name;
+	serviceEntryPoint();
+	return true;
+}
+
+
+
+void MacOSServiceFunctions::manageServerInstances()
+{
+	// The servers are managed by launchd: this service watches the console
+	// session and keeps a Veyon server running for the user that is logged
+	// in at the console.
+	MacOSServiceCore serviceCore;
+	serviceCore.run();
+}
