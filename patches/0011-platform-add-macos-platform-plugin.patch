index 000000000..f7587af43
--- /dev/null
+++ b/plugins/platform/macos/MacOSKeyboardShortcutTrapper.cpp
@@ -0,0 +1,204 @@
+/*
+ * MacOSKeyboardShortcutTrapper.cpp - implementation of MacOSKeyboardShortcutTrapper class
+ *
+ * Copyright (c) 2026 Veyon Community
+ *
+ * This file is part of Veyon - https://veyon.io
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public
+ * License as published by the Free Software Foundation; either
+ * version 2 of the License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public
+ * License along with this program (see COPYING); if not, write to the
+ * Free Software Foundation, Inc., 59 Temple Place - Suite 330,
+ * Boston, MA 02111-1307, USA.
+ *
+ */
+
+#include "MacOSKeyboardShortcutTrapper.h"
+
+#import <AppKit/AppKit.h>
+#import <Carbon/Carbon.h>
+#import <CoreGraphics/CoreGraphics.h>
+
+class MacOSKeyboardShortcutTrapper::Private
+{
+public:
+	CFMachPortRef eventTap = nullptr;
+	CFRunLoopRef runLoop = nullptr;
+	bool enabled = false;
+
+	~Private()
+	{
+		disable();
+	}
+
+	void disable()
+	{
+		if ( eventTap != nullptr )
+		{
+			CGEventTapEnable( eventTap, false );
+			CFRelease( eventTap );
+			eventTap = nullptr;
+		}
+		enabled = false;
+	}
+
+	static CGEventRef eventTapCallback( CGEventTapProxy proxy, CGEventType type,
+										CGEventRef event, void* userInfo )
+	{
+		auto* self = static_cast<Private*>( userInfo );
+
+		if ( type == kCGEventTapDisabledByTimeout || type == kCGEventTapDisabledByUserInput )
+		{
+			// Re-enable the tap so that it keeps working after a timeout.
+			if ( self->eventTap != nullptr )
+			{
+				CGEventTapEnable( self->eventTap, true );
+			}
+			return event;
+		}
+
+		if ( type != kCGEventKeyDown && type != kCGEventFlagsChanged )
+		{
+			return event;
+		}
+
+		const auto keycode = static_cast<int>( CGEventGetIntegerValueField( event, kCGKeyboardEventKeycode ) );
+		const auto flags = CGEventGetFlags( event );
+
+		KeyboardShortcutTrapper::Shortcut shortcut = KeyboardShortcutTrapper::NoShortcut;
+
+		const bool altPressed = ( flags & kCGEventFlagMaskAlternate ) != 0;
+		const bool controlPressed = ( flags & kCGEventFlagMaskControl ) != 0;
+		const bool commandPressed = ( flags & kCGEventFlagMaskCommand ) != 0;
+
+		if ( type == kCGEventFlagsChanged )
+		{
+			// Detect the press and the release of the Command ("Super") key.
+			if ( keycode == kVK_Command && commandPressed )
+			{
+				shortcut = KeyboardShortcutTrapper::SuperKeyDown;
+			}
+			else if ( keycode == kVK_Command && commandPressed == false )
+			{
+				shortcut = KeyboardShortcutTrapper::SuperKeyUp;
+			}
+		}
+		else
+		{
+			switch ( keycode )
+			{
+				case kVK_Tab:
+					if ( altPressed )
+					{
+						shortcut = KeyboardShortcutTrapper::AltTab;
+					}
+					break;
+
+				case kVK_Escape:
+					if ( altPressed )
+					{
+						shortcut = KeyboardShortcutTrapper::AltEsc;
+					}
+					else if ( controlPressed )
+					{
+						shortcut = KeyboardShortcutTrapper::CtrlEsc;
+					}
+					break;
+
+				case kVK_Space:
+					if ( altPressed )
+					{
+						shortcut = KeyboardShortcutTrapper::AltSpace;
+					}
+					break;
+
+				default:
+					break;
+			}
+		}
+
+		if ( shortcut != KeyboardShortcutTrapper::NoShortcut )
+		{
+			QMetaObject::invokeMethod( self->trapper,
+									  "shortcutTrapped",
+									  Qt::DirectConnection,
+									  Q_ARG( KeyboardShortcutTrapper::Shortcut, shortcut ) );
+
+			// Swallow the key event so that the system shortcut is not
+			// executed locally while it is being handled remotely.
+			return nullptr;
+		}
+
+		return event;
+	}
+
+	MacOSKeyboardShortcutTrapper* trapper = nullptr;
+};
+
+
+
+MacOSKeyboardShortcutTrapper::MacOSKeyboardShortcutTrapper( QObject* parent ) :
+	KeyboardShortcutTrapper( parent ),
+	d( new Private() )
+{
+	d->trapper = this;
+}
+
+
+
+MacOSKeyboardShortcutTrapper::~MacOSKeyboardShortcutTrapper()
+{
+	delete d;
+}
+
+
+
+void MacOSKeyboardShortcutTrapper::setEnabled( bool on )
+{
+	if ( d->enabled == on )
+	{
+		return;
+	}
+
+	if ( on == false )
+	{
+		d->disable();
+		return;
+	}
+
+	// A CGEventTap requires the Accessibility permission, which the user has
+	// to grant manually in System Settings > Privacy & Security > Accessibility.
+	CGEventMask eventMask = CGEventMaskBit( kCGEventKeyDown ) | CGEventMaskBit( kCGEventFlagsChanged );
+
+	d->eventTap = CGEventTapCreate( kCGSessionEventTap,
+									kCGHeadInsertEventTap,
+									kCGEventTapOptionDefault,
+									eventMask,
+									&MacOSKeyboardShortcutTrapper::Private::eventTapCallback,
+									d );
+
+	if ( d->eventTap == nullptr )
+	{
+		// Most likely the Accessibility permission has not been granted.
+		qWarning( "MacOSKeyboardShortcutTrapper: unable to create event tap, "
+				  "please grant the Accessibility permission to this application" );
+		return;
+	}
+
+	d->runLoop = CFRunLoopGetCurrent();
+	CFRunLoopAddSource( d->runLoop,
+						CFMachPortCreateRunLoopSource( kCFAllocatorDefault, d->eventTap, 0 ),
+						kCFRunLoopCommonModes );
+	CGEventTapEnable( d->eventTap, true );
+
+	d->enabled = true;
+}
