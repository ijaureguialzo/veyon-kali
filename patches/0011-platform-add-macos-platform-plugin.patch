+++ b/plugins/platform/macos/MacOSServiceCore.cpp
@@ -0,0 +1,387 @@
+/*
+ * MacOSServiceCore.cpp - implementation of MacOSServiceCore class
+ *
+ * Copyright (c) 2026 Veyon Community
+ *
+ * This file is part of Veyon - https://veyon.io
+ *
