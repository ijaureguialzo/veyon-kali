+ */
+
+#pragma once
+
+#include <QMap>
+#include <QString>
+#include <QTimer>
+
+#include "PlatformSessionManager.h"
+#include "ServiceDataManager.h"
+
+// clazy:excludeall=copyable-polymorphic
+
+/*!
+ * \brief Manages the Veyon server instances on macOS
+ *
+ * On macOS a system-wide daemon cannot access the graphical session of a
+ * user, so the Veyon server has to be started inside the Aqua session of
+ * the logged on user.  This class implements the usual two-tier model:
+ *
+ * - The service itself runs as a LaunchDaemon and watches for the user
+ *   that owns the current console session.
+ * - For every such user a LaunchAgent is bootstrapped into the GUI
+ *   session domain, which runs the actual Veyon server.
+ *
+ * The LaunchAgent is what makes the server able to capture the screen
+ * and to inject keyboard input, as those require access to the window
+ * server of the user's session.
+ */
+class MacOSServiceCore : public QObject
+{
+	Q_OBJECT
+public:
+	explicit MacOSServiceCore( QObject* parent = nullptr );
+	~MacOSServiceCore() override;
+
+	void run();
+
+private Q_SLOTS:
+	void checkConsoleSession();
+
+private:
+	static constexpr auto SessionProbingInterval = 3000;
+	static constexpr auto ServerRestartInterval = 5000;
+
+	/*!
+	 * \brief Returns the name of the user owning the current console session
+	 *
+	 * An empty string is returned if no user is logged in at the console
+	 * or if the session is not a local graphical one.
+	 */
+	static QString consoleUserName();
+
+	/*!
+	 * \brief Returns the home directory of the given user
+	 */
+	static QString userHomeDirectory( const QString& userName );
+
+	/*!
+	 * \brief Returns the UID of the given user, or -1 if it cannot be resolved
+	 */
+	static int userId( const QString& userName );
+
+	void startServer( const QString& userName );
+	void stopServer( const QString& userName );
+	void stopAllServers();
+
+	/*!
+	 * \brief Checks whether the server of the given user is still alive
+	 */
+	void checkServerState( const QString& userName );
+
+	/*!
+	 * \brief Writes the launch agent property list of the given user
+	 *
+	 * The property list is written to the LaunchAgents directory of the
+	 * user, because the agent has to be loaded into the GUI session
+	 * domain of that user.
+	 */
+	bool writeLaunchAgent( const QString& userName ) const;
+
+	/*!
+	 * \brief Removes the launch agent of the given user
+	 */
+	void removeLaunchAgent( const QString& userName ) const;
+
+	ServiceDataManager m_dataManager{};
+	PlatformSessionManager m_sessionManager{};
+
+	QMap<QString, MacOSServerProcess*> m_serverProcesses;
+};
