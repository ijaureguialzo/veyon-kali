+
+
+QString MacOSSessionFunctions::currentSessionType() const
+{
+	// Distinguish between a console session and a remote (SSH/VNC) one.
+	const auto sessionType = qEnvironmentVariable( "XPC_SERVICE_NAME" );
+	if ( sessionType.isEmpty() == false )
+	{
+		return QStringLiteral( "remote" );
+	}
+
+	return QStringLiteral( "console" );
+}
+
+
+
+bool MacOSSessionFunctions::currentSessionHasUser() const
+{
+	return getuid() != 0;
+}
