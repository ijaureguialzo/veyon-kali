+
+bool MacOSNetworkFunctions::configureFirewallException( const QString& applicationPath, const QString& description, bool enabled )
+{
+	// The macOS application firewall is configured through the
+	// "socketfilterfw" tool, which manages its rule list.  The tool is part
+	// of the system, so it does not add any dependency to the bundle.
+	if( applicationPath.isEmpty() )
+	{
+		return false;
+	}
+
+	const auto tool = QStandardPaths::findExecutable( QStringLiteral( "socketfilterfw" ) );
+	if( tool.isEmpty() )
+	{
+		return false;
+	}
+
+	// The rule of the application is added to or removed from the list of
+	// the allowed applications.  The firewall itself keeps its global
+	// state, because it is shared by the whole system.
+	QProcess process;
+	process.start( tool, { enabled ? QStringLiteral( "--add" ) :
+									   QStringLiteral( "--remove" ),
+						   applicationPath } );
+	if( process.waitForFinished( 10000 ) == false || process.exitCode() != 0 )
+	{
+		return false;
+	}
+
+	Q_UNUSED( description )
+
+	return true;
+}
+
+
+
+bool MacOSNetworkFunctions::configureSocketKeepalive( Socket socket, bool enabled, int idleTime, int interval, int probes )
+{
+	if ( socket == 0 )
+	{
+		return false;
+	}
+
+	const auto fd = static_cast<int>( socket );
+
+	int keepalive = enabled ? 1 : 0;
+	if ( ::setsockopt( fd, SOL_SOCKET, SO_KEEPALIVE, &keepalive, sizeof( keepalive ) ) != 0 )
+	{
+		return false;
+	}
+
+	if ( enabled == false )
+	{
+		return true;
+	}
+
+	// The keepalive parameters are only supported on macOS 10.15 and later.
+	if ( enabled )
+	{
+		const int idle = idleTime > 0 ? idleTime : 0;
+		const int intvl = interval > 0 ? interval : 0;
+		const int cnt = probes > 0 ? probes : 0;
+
+		::setsockopt( fd, IPPROTO_TCP, TCP_KEEPALIVE, &idle, sizeof( idle ) );
+		::setsockopt( fd, IPPROTO_TCP, TCP_KEEPINTVL, &intvl, sizeof( intvl ) );
+		::setsockopt( fd, IPPROTO_TCP, TCP_KEEPCNT, &cnt, sizeof( cnt ) );
+	}
+
+	return true;
+}
+
+
+
+QNetworkInterface MacOSNetworkFunctions::defaultRouteNetworkInterface()
+{
+	const auto interfaces = QNetworkInterface::allInterfaces();
+	for ( const auto& interface : interfaces )
+	{
+		const auto flags = interface.flags();
+		if ( flags.testFlag( QNetworkInterface::IsUp ) &&
+			 flags.testFlag( QNetworkInterface::IsRunning ) &&
+			 flags.testFlag( QNetworkInterface::IsLoopBack ) == false )
+		{
+			for ( const auto& address : interface.addressEntries() )
+			{
+				if ( address.ip().protocol() == QAbstractSocket::IPv4Protocol )
+				{
+					return interface;
+				}
+			}
+		}
+	}
+
+	return QNetworkInterface();
+}
+
+
+
+int MacOSNetworkFunctions::networkInterfaceSpeedInMBitPerSecond(const QNetworkInterface& networkInterface)
+{
+	if( networkInterface.isValid() == false )
+	{
+		return 0;
+	}
+
+	// The speed of a wired interface is reported by the driver of the
+	// controller, which is accessible through the registry of the IOKit
+	// without any special privileges.
+	const auto speed = controllerSpeedInMBitPerSecond( networkInterface.name() );
+	if( speed > 0 )
+	{
+		return speed;
+	}
+
+	// The kernel interface does not provide the media of the interface on
+	// every system, so it is used as a second option.
+	const auto mediaSpeed = mediaSpeedInMBitPerSecond( networkInterface.name() );
+	if( mediaSpeed > 0 )
+	{
+		return mediaSpeed;
+	}
+
+	// Wireless interfaces do not report a reliable speed, so the speed of
+	// the association is used for them.
+	return wirelessInterfaceSpeedInMBitPerSecond( networkInterface.name() );
+}
+
+
+
+int MacOSNetworkFunctions::mediaSpeedInMBitPerSecond( const QString& interfaceName )
+{
+	// The routing socket provides the media of the interface, which contains
+	// the maximum transfer rate of a wired interface.
+	const auto socketFd = ::socket( AF_INET, SOCK_DGRAM, 0 );
+	if( socketFd < 0 )
+	{
+		return 0;
+	}
+
+	struct ifreq request {};
+	QByteArray name = interfaceName.toUtf8();
+	if( name.size() >= IFNAMSIZ )
+	{
+		::close( socketFd );
+		return 0;
+	}
+	std::memcpy( request.ifr_name, name.constData(), static_cast<size_t>( name.size() ) );
+
+	if( ::ioctl( socketFd, SIOCGIFMEDIA, &request ) < 0 )
+	{
+		::close( socketFd );
+		return 0;
+	}
+
+	::close( socketFd );
+
+	// The media type of a wired interface reports the maximum transfer rate
+	// in the medium field.
+	if( IFM_TYPE( request.ifr_media ) != IFM_ETHER )
+	{
+		return 0;
+	}
+
+	if( ( request.ifr_media & IFM_LOOP ) != 0 )
+	{
+		return 0;
+	}
+
+	// The value is reported in bits per second.  The media type uses the
+	// upper bits of the field, so the speed is extracted from the option
+	// bits, which are stored in units of 1000 bits per second for the
+	// ethernet media types.
+	const auto speed = ( request.ifr_media & IFM_OMASK ) >> 8;
+	return static_cast<int>( speed ) * 1000;
+}
+
+
+
+int MacOSNetworkFunctions::controllerSpeedInMBitPerSecond( const QString& interfaceName )
+{
+	// The speed of the link is reported by the driver of the network
+	// controller, which is accessible through the registry of the IOKit
+	// without any special privileges.  The value is expressed in bits per
+	// second and is stored in the property "speed".
+	//
+	// The class of the interface entries depends on the driver of the
+	// interface.  Newer systems use the Skywalk stack, which provides its
+	// own class for the ethernet interfaces, so both of them are searched.
+	static const char* const interfaceClasses[] = {
+		"IOEthernetInterface",
+		"IOSkywalkLegacyEthernetInterface"
+	};
+
+	for( const auto* interfaceClass : interfaceClasses )
+	{
+		auto* matching = IOServiceMatching( interfaceClass );
+		if( matching == nullptr )
+		{
+			continue;
+		}
+
+		io_iterator_t iterator = 0;
+		if( IOServiceGetMatchingServices( kIOMainPortDefault, matching, &iterator ) != KERN_SUCCESS )
+		{
+			continue;
+		}
+
+		int speed = 0;
+
+		io_object_t interface = 0;
+		while( ( interface = IOIteratorNext( iterator ) ) != 0 )
+		{
+			// The name of the interface is stored in the property
+			// "BSD Name" of the entry itself.
+			auto* bsdName = static_cast<CFStringRef>(
+						IORegistryEntryCreateCFProperty( interface, CFSTR( "BSD Name" ),
+													   kCFAllocatorDefault, 0 ) );
+			auto* speedValue = static_cast<CFNumberRef>(
+						IORegistryEntryCreateCFProperty( interface, CFSTR( "speed" ),
+													   kCFAllocatorDefault, 0 ) );
+
+			// The interface is only taken into account when its name
+			// matches the one that is looked for.
+			if( bsdName != nullptr && speedValue != nullptr )
+			{
+				char nameBuffer[ IFNAMSIZ ] = { 0 };
+				if( CFStringGetCString( bsdName, nameBuffer, sizeof( nameBuffer ), kCFStringEncodingUTF8 ) &&
+					interfaceName.compare( QString::fromUtf8( nameBuffer ), Qt::CaseInsensitive ) == 0 )
+				{
+					long long bitsPerSecond = 0;
+					if( CFNumberGetValue( speedValue, kCFNumberLongLongType, &bitsPerSecond ) && bitsPerSecond > 0 )
+					{
+						speed = static_cast<int>( bitsPerSecond / 1000000 );
+					}
+				}
+			}
+
+			if( bsdName != nullptr )
+			{
+				CFRelease( bsdName );
+			}
+			if( speedValue != nullptr )
+			{
+				CFRelease( speedValue );
+			}
+
+			IOObjectRelease( interface );
+
+			if( speed > 0 )
+			{
+				break;
+			}
+		}
+
+		IOObjectRelease( iterator );
+
+		if( speed > 0 )
+		{
+			return speed;
+		}
+	}
+
+	return 0;
+}
+
+
+
+int MacOSNetworkFunctions::wirelessInterfaceSpeedInMBitPerSecond( const QString& interfaceName )
+{
+	// The speed of a wireless interface is not exposed by the kernel, but it
+	// can be read from the "IO80211Interface" key of the system
+	// configuration, using the SystemConfiguration framework.
+	SCDynamicStoreRef configuration = SCDynamicStoreCreate( nullptr, CFSTR( "Veyon" ), nullptr, nullptr );
+	if( configuration == nullptr )
+	{
+		return 0;
+	}
+	const auto key = QStringLiteral( "Setup:/Network/Interface/%1/AirPort" ).arg( interfaceName );
+	auto* keyString = CFStringCreateWithCString( nullptr, key.toUtf8().constData(), kCFStringEncodingUTF8 );
+
+	int speed = 0;
+
+	if( keyString != nullptr )
+	{
+		auto* value = SCDynamicStoreCopyValue( configuration, keyString );		if( value != nullptr )
+		{
+			if( CFGetTypeID( value ) == CFDictionaryGetTypeID() )
+			{
+				auto* dictionary = static_cast<CFDictionaryRef>( value );
+				auto* speedValue = CFDictionaryGetValue( dictionary, CFSTR( "LinkSpeed" ) );
+
+				// The link speed is reported in bits per second.
+				if( speedValue != nullptr && CFGetTypeID( speedValue ) == CFNumberGetTypeID() )
+				{
+					int linkSpeed = 0;
+					CFNumberGetValue( static_cast<CFNumberRef>( speedValue ), kCFNumberIntType, &linkSpeed );
+					speed = linkSpeed / 1000000;
+				}
+			}
+
+			CFRelease( value );
+		}
+
+		CFRelease( keyString );
+	}
+
+	CFRelease( configuration );
+
+	return speed;
+}
