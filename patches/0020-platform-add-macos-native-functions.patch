+
+PlatformSessionFunctions::SessionId MacOSSessionFunctions::currentSessionId()
+{
+	// macOS does not have a session id concept comparable to the Linux one.
+	// Use the id of the security session of the current process, which is
+	// stable for the lifetime of the login session.
+	return DefaultSessionId;
+}
+
+
+
+PlatformSessionFunctions::SessionUptime MacOSSessionFunctions::currentSessionUptime() const
+{
+	// The login session start time can be obtained from the "who" command or
+	// from the ConsoleUser directory.  Use the "who -u" output which reports
+	// the login time of the console user.
+	QProcess process;
+	process.start( QStringLiteral( "/usr/bin/who" ), { QStringLiteral( "-u" ) } );
+	if ( process.waitForStarted( 3000 ) == false )
+	{
+		return InvalidSessionUptime;
+	}
+	process.waitForFinished( 3000 );
+
+	const auto output = QString::fromUtf8( process.readAllStandardOutput() );
+	const auto lines = output.split( QLatin1Char( '\n' ), Qt::SkipEmptyParts );
+	if ( lines.isEmpty() )
+	{
+		return InvalidSessionUptime;
+	}
+
+	// The last column of "who -u" contains the login time in the format
+	// "HH:MM" for today.
+	const auto fields = lines.first().split( QLatin1Char( ' ' ), Qt::SkipEmptyParts );
+	if ( fields.isEmpty() )
+	{
+		return InvalidSessionUptime;
+	}
+
+	const auto timeString = fields.last();
+	const auto timeParts = timeString.split( QLatin1Char( ':' ) );
+	if ( timeParts.size() != 2 )
+	{
+		return InvalidSessionUptime;
+	}
+
+	bool ok = false;
+	const auto hours = timeParts.at( 0 ).toInt( &ok );
+	if ( ok == false )
+	{
+		return InvalidSessionUptime;
+	}
+	const auto minutes = timeParts.at( 1 ).toInt( &ok );
+	if ( ok == false )
+	{
+		return InvalidSessionUptime;
+	}
+
+	const auto now = QDateTime::currentDateTime();
+	QDateTime loginTime( now.date(), QTime( hours, minutes ) );
+	if ( loginTime > now )
+	{
+		// The login happened yesterday.
+		loginTime = loginTime.addDays( -1 );
+	}
+
+	return static_cast<SessionUptime>( loginTime.secsTo( now ) );
+}
+
+
+
+QString MacOSSessionFunctions::currentSessionClientAddress() const
+{
+	// The client of a local session is the machine itself.
+	QString address;
+	const auto hostInfo = QHostInfo::fromName( QHostInfo::localHostName() );
+	if ( hostInfo.error() != QHostInfo::NoError )
+	{
+		return {};
+	}
+
+	for ( const auto& addressEntry : hostInfo.addresses() )
+	{
+		if ( addressEntry.protocol() == QAbstractSocket::IPv4Protocol )
+		{
+			address = addressEntry.toString();
+			break;
+		}
+	}
+
+	return address;
+}
+
+
+
+QString MacOSSessionFunctions::currentSessionClientName() const
+{
+	return QHostInfo::localHostName();
+}
+
+
+
+QString MacOSSessionFunctions::currentSessionHostName() const
+{
+	return QSysInfo::machineHostName();
+}
