+
+bool MacOSUserFunctions::isAnyUserLoggedOn()
+{
+	// The console user is reported by the WindowServer.  A non-empty
+	// "SConsoleUser" key means that a user is logged in graphically.
+	QProcess process;
+	process.start( QStringLiteral( "/usr/bin/stat" ),
+				  { QStringLiteral( "-f" ), QStringLiteral( "%Su" ), QStringLiteral( "/dev/console" ) } );
+	if ( process.waitForStarted( 3000 ) == false )
+	{
+		return false;
+	}
+	process.waitForFinished( 3000 );
+
+	const auto user = QString::fromUtf8( process.readAllStandardOutput() ).trimmed();
+	return user.isEmpty() == false && user != QLatin1String( "root" );
+}
