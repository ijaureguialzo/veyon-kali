+	 * \brief Returns the speed of a wireless interface in MBit per second
+	 *
+	 * The kernel does not report the speed of a wireless interface, so it
+	 * is read from the system configuration.
+	 */
+	int wirelessInterfaceSpeedInMBitPerSecond( const QString& interfaceName );
+
+	/*!
+	 * \brief Returns the speed of an interface in MBit per second
+	 *
+	 * The speed is read from the media of the interface, which is provided
+	 * by the kernel for the wired interfaces.
+	 */
+	int mediaSpeedInMBitPerSecond( const QString& interfaceName );
+
+	/*!
+	 * \brief Returns the speed of an interface in MBit per second
+	 *
+	 * The speed is read from the driver of the network controller, which
+	 * reports the negotiated speed of the link.
+	 */
+	int controllerSpeedInMBitPerSecond( const QString& interfaceName );
+};
