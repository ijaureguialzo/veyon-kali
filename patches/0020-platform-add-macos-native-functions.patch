+// The ICMP message types are not declared by the headers of the system, so
+// they are defined here.  They are part of the ICMP protocol, as described
+// in RFC 792, and are used by the echo request and its reply.
+constexpr uint8_t IcmpEchoRequest = 8;
+constexpr uint8_t IcmpEchoReply = 0;
+
+} // namespace
+
+
+
+PlatformNetworkFunctions::PingResult MacOSNetworkFunctions::ping(const QString& hostAddress)
+{
+	// The host name is resolved first, so that a failing name resolution
+	// can be reported separately from a failing host.
+	QHostAddress address;
+	if( address.setAddress( hostAddress ) == false )
+	{
+		const auto hostInfo = QHostInfo::fromName( hostAddress );
+		if( hostInfo.error() != QHostInfo::NoError || hostInfo.addresses().isEmpty() )
+		{
+			return PingResult::NameResolutionFailed;
+		}
+
+		address = hostInfo.addresses().first();
+	}
+
+	// A datagram socket is used instead of a raw socket, because raw
+	// sockets require root privileges.  The ICMP echo request is sent
+	// through the "SOCK_DGRAM" ICMP socket, which is available to
+	// unprivileged processes since macOS 10.9 and does not require any
+	// special entitlement.
+	const auto socketFd = ::socket( AF_INET, SOCK_DGRAM, IPPROTO_ICMP );
+	if( socketFd < 0 )
+	{
+		return PingResult::Unknown;
+	}
+
+	// The socket is put into non-blocking mode, so that the timeout can
+	// be implemented with a poll instead of a blocking receive.
+	const int flags = ::fcntl( socketFd, F_GETFL, 0 );
+	::fcntl( socketFd, F_SETFL, flags | O_NONBLOCK );
+
+	struct sockaddr_in destination {};
+	destination.sin_family = AF_INET;
+	destination.sin_port = htons( 0 );
+	if( ::inet_pton( AF_INET, address.toString().toLatin1().constData(), &destination.sin_addr ) != 1 )
+	{
+		::close( socketFd );
+		return PingResult::Unknown;
+	}
+
+	// The ICMP echo request consists of a type, a code, a checksum, an
+	// identifier and a sequence number.  The payload is not required for
+	// the reply to be generated.
+	struct icmpHeader
+	{
+		uint8_t type;
+		uint8_t code;
+		uint16_t checksum;
+		uint16_t identifier;
+		uint16_t sequence;
+	} header {};
+
+	header.type = IcmpEchoRequest;
+	header.code = 0;
+	header.identifier = htons( static_cast<uint16_t>( ::getpid() & 0xFFFF ) );
+	header.sequence = htons( 1 );
+
+	// The checksum is calculated over the whole header.
+	uint32_t sum = 0;
+	const auto* headerBytes = reinterpret_cast<const uint8_t *>( &header );
+	for( size_t i = 0; i < sizeof( header ); i += 2 )
+	{
+		sum += static_cast<uint16_t>( headerBytes[ i ] ) << 8;
+		sum += headerBytes[ i + 1 ];
+	}
+	while( sum >> 16 )
+	{
+		sum = ( sum & 0xFFFF ) + ( sum >> 16 );
+	}
+	header.checksum = htons( static_cast<uint16_t>( ~sum ) );
+
+	if( ::sendto( socketFd, &header, sizeof( header ), 0,
+				 reinterpret_cast<struct sockaddr *>( &destination ), sizeof( destination ) ) < 0 )
+	{
+		::close( socketFd );
+		return PingResult::Unknown;
+	}
+
+	// The reply is awaited until the timeout expires.
+	struct pollfd pollDescriptor {};
+	pollDescriptor.fd = socketFd;
+	pollDescriptor.events = POLLIN;
+
+	const auto pollResult = ::poll( &pollDescriptor, 1, PingTimeout );
+
+	if( pollResult < 0 )
+	{
+		::close( socketFd );
+		return PingResult::Unknown;
+	}
+
+	if( pollResult == 0 )
+	{
+		// No reply arrived within the timeout.
+		::close( socketFd );
+		return PingResult::TimedOut;
+	}
+
+	uint8_t buffer[ 256 ];
+	const auto received = ::recvfrom( socketFd, buffer, sizeof( buffer ), 0, nullptr, nullptr );
+	::close( socketFd );
+
+	if( received < static_cast<ssize_t>( sizeof( struct icmpHeader ) ) )
+	{
+		return PingResult::TimedOut;
+	}
+
+	// The reply of an ICMP datagram socket starts with the original header,
+	// so the type of the answer is checked directly.
+	if( buffer[ 0 ] == IcmpEchoReply )
+	{
+		return PingResult::ReplyReceived;
+	}
+
+	return PingResult::TimedOut;
+}
