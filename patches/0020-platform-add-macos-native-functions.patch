+
+
+bool MacOSUserFunctions::prepareLogon( const QString& username, const Password& password )
+{
+	// macOS does not support a separate preparation phase for logons.  The
+	// credentials are only validated when the logon is performed.
+	Q_UNUSED( username )
+	Q_UNUSED( password )
+	return true;
+}
+
+
+
+bool MacOSUserFunctions::performLogon( const QString& username, const Password& password )
+{
+	// The credentials are verified against the Open Directory, so that a
+	// wrong password is reported before the session is changed.
+	if( authenticate( username, password ) == false )
+	{
+		return false;
+	}
+
+	// A graphical logon is performed through the fast user switching of
+	// macOS, which is the only mechanism that the system offers without
+	// privileged helpers.  The switch is triggered by the keyboard
+	// shortcut, which is handled by the window server of the current
+	// session.
+	//
+	// The user that is going to be logged on has to be selected in the
+	// switcher afterwards, so the logon is only reported as successful
+	// when the switcher could be opened.
+	const auto switcherOpened = runCommand( QStringLiteral( "/usr/bin/osascript" ),
+											{ QStringLiteral( "-e" ),
+											  QStringLiteral( "tell application \"System Events\" to key code 12 using {command down, control down}" ) } );
+
+	if( switcherOpened.isEmpty() == false )
+	{
+		return true;
+	}
+
+	// Without a graphical session the fast user switching is not available.
+	// The logon is then rejected, because the user would not be able to
+	// interact with the session anyway.
+	return false;
+}
+
+
+
+void MacOSUserFunctions::logoff()
+{
+	// The logoff of the current session is triggered by the keyboard
+	// shortcut of the system, which asks the window server to close the
+	// session.  The confirmation dialog is shown by the system itself.
+	runCommand( QStringLiteral( "/usr/bin/osascript" ),
+				{ QStringLiteral( "-e" ),
+				  QStringLiteral( "tell application \"System Events\" to key code 12 using {command down, shift down}" ) } );
+}
+
+
+
+bool MacOSUserFunctions::authenticate( const QString& username, const Password& password )
+{
+	// Authentication is delegated to the Open Directory via the
+	// "/usr/bin/dscl" "-authonly" command, which verifies a password
+	// without changing the session state.
+	const auto passwordString = QString::fromUtf8( password.constData() );
+
+	QProcess process;
+	process.start( QStringLiteral( "/usr/bin/dscl" ),
+				  { QStringLiteral( "." ), QStringLiteral( "-authonly" ),
+					username, passwordString } );
+	if ( process.waitForStarted( 5000 ) == false )
+	{
+		return false;
+	}
+	process.waitForFinished( 15000 );
+
+	return process.exitCode() == 0;
+}
