+
+
+QVariant MacOSSessionFunctions::querySettingsValueInCurrentSession(const QString& key) const
+{
+	// macOS stores its per-user preferences in the CFPreferences mechanism.
+	// The well known Veyon keys are mapped to their macOS equivalents, so
+	// that the configuration of the Linux version can be reused.
+	static const QHash<QString, QString> keyMapping = {
+		{ QStringLiteral( "Veyon/Framework/Configuration/Domain" ), QStringLiteral( "VeyonDomain" ) },
+		{ QStringLiteral( "Veyon/Framework/Network/Server" ), QStringLiteral( "VeyonServer" ) },
+	};
+
+	const auto preferencesKey = keyMapping.value( key, key );
+
+	// The preferences of the current user are read from the standard domain
+	// of the application.
+	CFStringRef cfKey = CFStringCreateWithCString( nullptr,
+													preferencesKey.toUtf8().constData(),
+													kCFStringEncodingUTF8 );
+	if( cfKey == nullptr )
+	{
+		return {};
+	}
+
+	auto* value = CFPreferencesCopyAppValue( cfKey, kCFPreferencesCurrentUser );
+	CFRelease( cfKey );
+
+	if( value == nullptr )
+	{
+		return {};
+	}
+
+	// The value is converted into a Qt variant, depending on its type.
+	QVariant result;
+	const auto type = CFGetTypeID( value );
+
+	if( type == CFStringGetTypeID() )
+	{
+		auto string = CFStringGetCStringPtr( static_cast<CFStringRef>( value ), kCFStringEncodingUTF8 );
+		if( string != nullptr )
+		{
+			result = QString::fromUtf8( string );
+		}
+	}
+	else if( type == CFBooleanGetTypeID() )
+	{
+		result = CFBooleanGetValue( static_cast<CFBooleanRef>( value ) ) != false;
+	}
+	else if( type == CFNumberGetTypeID() )
+	{
+		int number = 0;
+		if( CFNumberGetValue( static_cast<CFNumberRef>( value ), kCFNumberIntType, &number ) )
+		{
+			result = number;
+		}
+	}
+	else if( type == CFArrayGetTypeID() )
+	{
+		auto* array = static_cast<CFArrayRef>( value );
+		QStringList list;
+		const auto count = CFArrayGetCount( array );
+		for( CFIndex i = 0; i < count; ++i )
+		{
+			auto* element = CFArrayGetValueAtIndex( array, i );
+			if( element == nullptr || CFGetTypeID( element ) != CFStringGetTypeID() )
+			{
+				continue;
+			}
+
+			auto string = CFStringGetCStringPtr( static_cast<CFStringRef>( element ), kCFStringEncodingUTF8 );
+			if( string != nullptr )
+			{
+				list.append( QString::fromUtf8( string ) );
+			}
+		}
+		result = list;
+	}
+
+	CFRelease( value );
+
+	return result;
+}
