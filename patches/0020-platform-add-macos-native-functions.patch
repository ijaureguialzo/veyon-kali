+
+QString MacOSUserFunctions::queryCurrentUserProperty(UserProperty property)
+{
+	const auto* user = ::getpwuid( ::getuid() );
+	if ( user == nullptr )
+	{
+		return {};
+	}
+
+	switch ( property )
+	{
+		case UserProperty::LoginName:
+			return QString::fromUtf8( user->pw_name );
+
+		case UserProperty::FullName:
+		{
+			// The full name is stored in the GECOS field of the password
+			// database.  Use "dscl" to read the real-name attribute, which
+			// also works for accounts from a directory service.
+			const auto fullName = runCommand( QStringLiteral( "/usr/bin/dscl" ),
+											 { QStringLiteral( "." ), QStringLiteral( "read" ),
+											   QStringLiteral( "/Users/%1" ).arg( QString::fromUtf8( user->pw_name ) ),
+											   QStringLiteral( "RealName" ) } );
+			if ( fullName.isEmpty() == false )
+			{
+				return fullName;
+			}
+
+			return QString::fromUtf8( user->pw_gecos );
+		}
+
+		case UserProperty::None:
+			break;
+	}
+
+	return {};
+}
+
+
+
+QStringList MacOSUserFunctions::userGroups( bool queryDomainGroups )
+{
+	// The "staff" group contains all users of the machine.
+	if ( queryDomainGroups )
+	{
+		const auto domainGroups = runCommand( QStringLiteral( "/usr/bin/dscl" ),
+											  { QStringLiteral( "." ), QStringLiteral( "read" ),
+												QStringLiteral( "/Users/%1" ).arg( QDir::home().dirName() ),
+												QStringLiteral( "MemberOf" ) } );
+		if ( domainGroups.isEmpty() == false )
+		{
+			QStringList groups;
+			const auto lines = domainGroups.split( QLatin1Char( '\n' ), Qt::SkipEmptyParts );
+			for ( const auto& line : lines )
+			{
+				auto group = line.trimmed();
+				if ( group.startsWith( QLatin1String( "MemberOf: " ) ) )
+				{
+					group = group.mid( 10 ).trimmed();
+				}
+				if ( group.isEmpty() == false )
+				{
+					groups += group;
+				}
+			}
+			return groups;
+		}
+	}
+
+	return { QStringLiteral( "staff" ) };
+}
+
+
+
+QStringList MacOSUserFunctions::groupsOfUser( const QString& username, bool queryDomainGroups )
+{
+	Q_UNUSED( queryDomainGroups )
+
+	QStringList groups;
+
+	const auto* user = ::getpwnam( username.toUtf8().constData() );
+	if ( user != nullptr )
+	{
+		int groupCount = 0;
+		::getgrouplist( user->pw_name, user->pw_gid, nullptr, &groupCount );
+		if ( groupCount > 0 )
+		{
+			QVector<int> groupIds( groupCount );
+			if ( ::getgrouplist( user->pw_name, user->pw_gid, groupIds.data(), &groupCount ) >= 0 )
+			{
+				for ( const auto groupId : groupIds )
+				{
+					const auto* group = ::getgrgid( static_cast<gid_t>( groupId ) );
+					if ( group != nullptr )
+					{
+						groups += QString::fromUtf8( group->gr_name );
+					}
+				}
+			}
+		}
+	}
+
+	return groups;
+}
+
+
+
+QString MacOSUserFunctions::userGroupSecurityIdentifier(const QString& groupName)
+{
+	// macOS groups are identified by their POSIX group id.
+	const auto* group = ::getgrnam( groupName.toUtf8().constData() );
+	if ( group == nullptr )
+	{
+		return {};
+	}
+
+	return QString::number( static_cast<uint>( group->gr_gid ) );
+}
