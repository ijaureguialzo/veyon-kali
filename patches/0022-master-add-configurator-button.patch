+void MainWindow::openConfigurator()
+{
+	// El configurador se lanza como proceso independiente, de modo que
+	// pueda pedir privilegios de administrador cuando hace falta.
+	//
+	// Dentro de un bundle de macOS el ejecutable esta en Contents/MacOS,
+	// junto al master, y fuera de el esta en el directorio del binario.
+	// Se buscan las dos ubicaciones para que el boton funcione tanto
+	// desde el bundle como desde el arbol de compilacion.
+	const auto appDir = QCoreApplication::applicationDirPath();
+
+	QStringList candidates;
+	candidates << appDir + QStringLiteral("/veyon-configurator");
+
+	// En una instalacion en /Applications el ejecutable puede estar en
+	// /Applications/Veyon.app/Contents/MacOS, y el bundle se localiza a
+	// partir de la ruta del propio master.
+	const auto bundleDir = QFileInfo( appDir ).absolutePath();
+	candidates << bundleDir + QStringLiteral("/veyon-configurator");
+
+	QString configurator;
+	for( const auto& candidate : candidates )
+	{
+		if( QFileInfo::exists( candidate ) )
+		{
+			configurator = candidate;
+			break;
+		}
+	}
+
+	if( configurator.isEmpty() )
+	{
+		// Si no se encuentra en el bundle, se busca en el PATH, por si el
+		// configurador se instalo como un ejecutable suelto.
+		configurator = QStandardPaths::findExecutable( QStringLiteral("veyon-configurator") );
+	}
+
+	if( configurator.isEmpty() )
+	{
+		QMessageBox::warning( this,
+							  tr( "Veyon Configurator not found" ),
+							  tr( "The Veyon Configurator executable could not be found. "
+								  "Looked in %1." ).arg( candidates.join( QStringLiteral( ", " ) ) ) );
+		return;
+	}
+
+	auto* process = new QProcess( this );
+	process->setProgram( configurator );
+	process->setProcessChannelMode( QProcess::ForwardedChannels );
+
+	connect( process, &QProcess::errorOccurred, this,
+			 [this, configurator]( QProcess::ProcessError error )
+	{
+		if( error == QProcess::FailedToStart )
+		{
+			QMessageBox::warning( this,
+								  tr( "Veyon Configurator not found" ),
+								  tr( "The Veyon Configurator could not be started: %1" ).arg( configurator ) );
+		}
+	} );
+
+	connect( process, &QProcess::finished, process, &QProcess::deleteLater );
+
+	process->start();
+}
