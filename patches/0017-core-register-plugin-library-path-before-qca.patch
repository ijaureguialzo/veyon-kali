+void VeyonCore::initLibraryPaths()
+{
+	// El gestor de plugins registra el directorio de plugins en la lista de
+	// rutas de biblioteca de Qt, pero lo hace más tarde que la inicialización
+	// de QCA.  Como QCA escanea sus providers en cuanto se construye, conviene
+	// registrar la ruta desde el principio para que sólo se carguen los
+	// providers que acompañan a la aplicación.
+	QDir dir( QCoreApplication::applicationDirPath() );
+	if( dir.cd( VeyonCore::pluginDir() ) )
+	{
+		QCoreApplication::addLibraryPath( dir.absolutePath() );
+	}
+}
